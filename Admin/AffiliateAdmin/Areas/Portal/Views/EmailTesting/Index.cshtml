
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Email</title>
    <link rel="icon" href="~/favicon.ico?v=1">
</head>
<body>
    <div>
        <div>
            Format:
            <label for="Html">
                <input name="Format" id="Html" type="radio" checked value="cshtml" />
                Html
            </label>
            <label for="PlainText">
                <input name="Format" id="PlainText" type="radio" value="txt" />
                Plain Text
            </label>
        </div>
        <div>
            Language:
            <label for="enUS">
                <input name="Language" id="enUS" type="radio" checked value="en-US" />
                English
            </label>
            <label for="esES">
                <input name="Language" id="esES" type="radio" value="es-ES" />
                Spanish
            </label>
            <label for="enGB">
                <input name="Language" id="enGB" type="radio" value="en-GB" />
                English (Europe)
            </label>
            <label for="hiIn">
                <input name="Language" id="hiIn" type="radio" value="hi-IN" />
                English (India)
            </label>
            <label for="idID">
                <input name="Language" id="idID" type="radio" value="id-ID" />
                Indonesian
            </label>
            <label for="jaJP">
                <input name="Language" id="jaJP" type="radio" value="ja-JP" />
                Japan
            </label>
            <label for="koKR">
                <input name="Language" id="koKR" type="radio" value="ko-KR" />
                Korean
            </label>
            <label for="thTH">
                <input name="Language" id="thTH" type="radio" value="th-TH" />
                Thai
            </label>
            <label for="viVN">
                <input name="Language" id="viVN" type="radio" value="vi-VN" />
                Vietnamese
            </label>
            <label for="zhCN">
                <input name="Language" id="zhCN" type="radio" value="zh-CN" />
                Chinese Simplified
            </label>
            <label for="zhTW">
                <input name="Language" id="zhTW" type="radio" value="zh-TW" />
                Chinese Traditional
            </label>
            <label for="kmKH">
                <input name="Language" id="kmKH" type="radio" value="km-KH" />
                Cambodian
            </label>
            <label for="bnBD">
                <input name="Language" id="bnBD" type="radio" value="bn-BD" />
                English (Bangladesh)
            </label>
            <label for="enPH">
                <input name="Language" id="enPH" type="radio" value="en-PH" />
                English (Philippines)
            </label>
        </div>

        <div>
            Function:
            <label for="AffiliateDisapproved">
                <input name="Function" id="AffiliateDisapproved" type="radio" checked value="AffiliateDisapproved" />
                AffiliateDisapproved
            </label>
            <label for="AffiliateApproved">
                <input name="Function" id="AffiliateApproved" type="radio" checked value="AffiliateApproved" />
                AffiliateApproved
            </label>
            <label for="AffiliateInformation">
                <input name="Function" id="AffiliateInformation" type="radio" value="AffiliateInformation" />
                AffiliateInformation
            </label>
            <label for="WithdrawalGuidance">
                <input name="Function" id="WithdrawalGuidance" type="radio" value="WithdrawalGuidance" />
                WithdrawalGuidance
            </label>
            <label for="PaymentRequest/Approved">
                <input name="Function" id="PaymentRequest/Approved" type="radio" value="PaymentRequest/Approved" />
                PaymentRequest/Approved
            </label>
            <label for="PaymentRequest/Rejected">
                <input name="Function" id="PaymentRequest/Rejected" type="radio" value="PaymentRequest/Rejected" />
                PaymentRequest/Rejected
            </label>
        </div>

        <div>
            <input id="emailAddress" type="text" placeholder="enter email address to send" />
        </div>

        <div>
            <button type="button" id="btnPreview">Preview</button>
            <button type="button" id="btnSendMail">Send Email</button>
        </div>

        <div style="margin: 15px auto; border: 1px solid #808080; padding: 15px" id="resultContent">
        </div>
    </div>

    <input id="rootAction" type="hidden" value="@Url.Content("~/")" />
    <script src="~/Areas/Portal/www/dist/jquery-3.3.1.min.js"></script>
    <script>
        $(function () {
            Aff12BTesting.initialize();
        })

        var Aff12BTesting = (function ($) {
            function getUrl(actionName) {
                var rootAction = $("#rootAction").val();
                var format = $('input[name=Format]:checked').val() || "cshtml";
                var language = $('input[name=Language]:checked').val() || "en-US";
                var functionName = $('input[name=Function]:checked').val();
                return rootAction + "Portal/EmailTesting/" + actionName + "?language=" + language + "&function=" + functionName + "&format=" + format;
            }

            return {
                initialize: function () {
                    Aff12BTesting.initEvent();
                },

                initEvent: function () {
                    $("#btnPreview").on("click", function () {
                        $("#resultContent").html("");

                        var url = getUrl("Preview");

                        $.ajax({
                            type: "GET",
                            dataType: "html",
                            cache: false,
                            url: url,
                            success: function (response) {
                                $("#resultContent").html(response);
                            }
                        });
                    });

                    $("#btnSendMail").on("click", function () {
                        $("#resultContent").html("");
                        var emailAddress = $("#emailAddress").val();
                        if (!emailAddress) {
                            $("#resultContent").html("Please enter email address");
                            return;
                        }

                        var url = getUrl("SendEmail");
                        url += "&EmailAddress=" + emailAddress;

                        $.ajax({
                            type: "POST",
                            dataType: "json",
                            cache: false,
                            url: url,
                            success: function (response) {
                                if (response.Success) {
                                    $("#resultContent").html("Send Successfully");
                                }
                                else {
                                    var message = "Send Failed<br />" + response.Message;
                                    $("#resultContent").html(message);
                                }
                            }
                        });
                    });
                }
            };
        })(jQuery);
    </script>
</body>
</html>
