@using Fanex.Affiliate.Admin.Core.DTO.Operation
@using Fanex.Affiliate.Admin.Core.Utilities
@{
    var dealList = (IEnumerable<NormalDeal>)ViewBag.Deals;
}

@section pagecss{
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/report.css")" rel="stylesheet" />
    <link href="@Url.VersionedLink("~/Areas/Portal/www/dist/style/pages/operation/deal.css")" rel="stylesheet" />
}

@section pagejs{
    <script type="text/javascript">
        window.initialState = {
            deals: @Html.Raw(Json.Encode(dealList)),
            today: '@DateTimeHelper.Gmt8NowString'
        }
    </script>
    <script type="text/javascript" src="@Url.VersionedLink("~/Areas/Portal/www/dist/js/pages/report.js")"></script>
}