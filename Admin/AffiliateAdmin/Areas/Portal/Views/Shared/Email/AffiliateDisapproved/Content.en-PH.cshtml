@model Fanex.Affiliate.Admin.Core.DTO.Email.AffInformationEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                Dear @Model.FirstName,<br /><br />

                Thank you for submitting your request to join the 12BET Affiliate Program. After careful review, we regret to inform you that your application has been rejected.<br /><br />

                We appreciate your interest in partnering with 12BET, but unfortunately, we are unable to approve your request at this time. We have strict guidelines for our affiliates, and unfortunately, your application did not meet the standards 12BET has set over the years.<br /><br />

                We apologize for any inconvenience this may cause and encourage you to re-apply in the future as we all know online marketing is ever evolving. <br /><br />

                Our team wishes you the best in your future endeavours.<br /><br />

                Best regards,<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)