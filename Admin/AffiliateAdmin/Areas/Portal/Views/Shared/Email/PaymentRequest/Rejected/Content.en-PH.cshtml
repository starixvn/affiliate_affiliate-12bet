@model Fanex.Affiliate.Admin.Core.DTO.Email.PaymentRequestUpdateEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                Dear @Model.FirstName,<br /><br />

                Request reference number is @Model.TransId, dated @Model.TransDate.<br /><br />

                We regret to inform you that your payment request amount of $@Model.Amount has been rejected.<br /><br />

                Please contact us at <a href="mailto:@Model.MailContact">@Model.MailContact</a> for assistance.<br />
                This is a system auto generated email, please do not reply to this email directly.<br /><br />

                Sincerely,<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)