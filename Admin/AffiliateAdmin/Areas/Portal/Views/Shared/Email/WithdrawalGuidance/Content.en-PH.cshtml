@model Fanex.Affiliate.Admin.Core.DTO.Email.WithdrawalEmail

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                Dear @Model.FirstName,<br /><br />

                Congratulations on becoming our 12BET affiliate!<br /><br />

                To ensure for a faster payout for your affiliate, please take some time to read the following procedure for withdrawal:<br /><br />

                1. Please do not deposit in the 12BET Player account linked to 12BET affiliate account.<br /><br />
                2. In case you used the deposited account and your 12BET Affiliate account got approved then pls get in touch with your affiliate manager or email to <a href="mailto:@Model.MailContact">@Model.MailContact</a> to get it corrected.<br /><br />
                3. We will settle member's commission payout once in a month ( 8th day to 15th day of the month), please access your affiliate account and click on Payment request, enter the amount and request Payout.<br /><br />
                4. If your withdrawal request is approved, your fund will be automatically transferred to your 12BET Player betting account.<br /><br />
                5. You may request a withdrawal from your 12BET Player betting account anytime and there will be no additional charges.<br /><br />

                Please take note:<br /><br />
                1. Your 12BET betting account is for affiliate purpose only; please do not make any deposit or placing bet.<br /><br />
                2. Your 12BET betting account registered name must be the same registered name that you had registered in your affiliate account, and it must be your real name.<br /><br />
                
                Please do not hesitate to contact us if you have any further question.<br /><br />

                Sincerely,<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)