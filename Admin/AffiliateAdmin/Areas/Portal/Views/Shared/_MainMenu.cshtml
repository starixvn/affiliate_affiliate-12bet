@using Fanex.Affiliate.Admin.Core.Constants;
@using Fanex.Affiliate.Admin.Core.Services.Common;
@using System.Collections.Generic;
@using Fanex.Affiliate.Admin.Core.Constants;

@{
    var controllerName = ViewContext.RouteData.Values["Controller"].ToString();
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var claims = sessionService.ClaimIdentities.SelectMany(i => i.Claims);
    var menus = new Dictionary<string, string>
{
        {"Customer",Function.Affiliate },
        {"Affiliate",Function.Affiliate },
        {"Operation", Function.Deal },
        {"Player",Function.Player },
        {"Report",Function.AffReport },
        {"MediaGallery",Function.Media },
        {"Message",Function.HotNews },
        {"Administrator",Function.UserControl },
        {"Domain",Function.Domain },
    };

    // Marketing Tools submenu structure with permissions
    var marketingToolsSubmenus = new Dictionary<string, object>
    {
        {"LandingPageContentManagement", new { Functions = new string[] { Function.PageManagement, Function.AssetUploader, Function.RegistrationFormUploader }, Controller = "LandingPage", Action = "Index", DisplayName = "Landing Page Management" }},
        //{"LinkGenerator", new { Functions = new string[] { Function.LinkGenerator}, Controller = "LinkGenerator", Action = "Index", DisplayName = "Link Generator" }},
        {"CampaignManagement", new { Functions = new string[] { Function.AllCampaigns , Function.ComponentManagement  }, Controller = "CampaignManagement", Action = "Index", DisplayName = "Campaign Management" }},
    };

    // Check which marketing tools submenus the user has access to
    var availableMarketingTools = marketingToolsSubmenus.Where(submenu =>
    {
        var functions = ((string[])((dynamic)submenu.Value).Functions);
        return functions.Any(function => claims.Any(p => p.Type == function));
    }).ToList();

    if (availableMarketingTools.Any())
    {
        menus.Add("MarketingTools", Function.LandingPage); // Use any function as placeholder since we check submenus individually
    }

    var displayMenus = menus.Where(m =>
    {
        if (string.Equals("Report", m.Key, StringComparison.OrdinalIgnoreCase))
        {
            return claims.Any(p => p.Type == m.Value || p.Type == Function.TransferPlayerReport);
        }

        if (claims.Any(p => p.Type == m.Value))
        {
            return true;
        }

        return false;
    }).Select(m => m.Key);
}

@functions{
    public string GetMenuName(string menuKey)
    {
        switch (menuKey)
        {
            case "MediaGallery":
                return "Media Gallery";
            case "MarketingTools":
                return "Marketing Tools";
            default:
                return menuKey;
        }
    }
}
<ul class="nav menu-list">
    <li class="nav-item">
        <a class="nav-link @(controllerName == "Home" ? "active" : string.Empty)" href="@Url.Content("~/Portal/Home")">Home</a>
    </li>

    @foreach (var item in displayMenus)
    {
        if (item == "MarketingTools")
        {
            var isMarketingToolsActive = new[] { "PageBuilder", "AssetUploader", "FormManagement", "ModuleManagement" }.Contains(controllerName);
            <li class="nav-item dropdown" style="position: unset;">
                <a class="nav-link dropdown-toggle @(isMarketingToolsActive ? "active" : string.Empty)" 
                   id="@item" 
                   href="#" 
                   role="button" 
                   data-toggle="dropdown" 
                   aria-haspopup="true" 
                   aria-expanded="false">
                    @GetMenuName(item)
                </a>
                <div class="dropdown-menu" aria-labelledby="@item" style="position: absolute; font-size: 0.9rem">
                    @foreach (var submenu in availableMarketingTools)
                    {
                        var submenuData = (dynamic)submenu.Value;
                        var submenuController = submenuData.Controller;
                        var submenuAction = submenuData.Action;
                        var submenuDisplayName = submenuData.DisplayName;
                        var submenuActive = controllerName == submenuController ? "active" : string.Empty;
                        
                        <a class="dropdown-item @submenuActive" id="submenu-@submenuData.Controller" href="@Url.Content("~/Portal/" + submenuController)">
                            @submenuDisplayName
                        </a>
                    }
                </div>
            </li>
        }
        else
        {
            var active = "nav-link " + (controllerName == item ? "active" : string.Empty);
            <li class="nav-item">
                <a class="@active" id="@item" href="@Url.Content("~/Portal/"+item)">
                    @GetMenuName(item)
                </a>
            </li>
        }
    }
</ul>
<script type="text/javascript">
    window.globalVariables = {
        claims: @Html.Raw(claims.ToJson()),
    }
    var controllerName = '@controllerName';
    let element;

    switch(controllerName) {
        case 'PaymentRequest': case 'PaymentRequest': case 'RevenueGroup': case 'EmailHistory': case 'MarketingAccount':
            element = document.getElementById('Affiliate');
            break;
        case 'Report': case 'PlayerGgrReport': case 'TransferReport': case 'AffiliateCpaReport': case 'PlayerCpaReport': case 'RedepositCpaReport':
            element = document.getElementById('Report');
            break;
        case 'Operation':
            element = document.getElementById('Operation');
            break;
        case 'LandingPageList':
            element = document.getElementById('MediaGallery');
            break;
        case 'PageBuilder': case 'AssetUploader': case 'FormManagement': case 'ModuleManagement':
            document.getElementById('submenu-LandingPage')?.classList.add("active");
            element = document.getElementById('MarketingTools');
            break;
        case 'Department':
            element = document.getElementById('Administrator');
            break;
        case 'Domain': case 'DomainControl': case 'SubAffDomain': case 'SpecificDomainControl':
            element = document.getElementById('Domain');
            break;
    }

    element && element.classList.add("active");

    // Handle dropdown functionality for Marketing Tools
    document.addEventListener('DOMContentLoaded', function() {
        const dropdown = document.querySelector('.nav-item.dropdown');
        const dropdownToggle = document.querySelector('.dropdown-toggle');
        const dropdownMenu = document.querySelector('.dropdown-menu');
        
        if (dropdown && dropdownToggle && dropdownMenu) {
            // Toggle dropdown on click
            dropdownToggle.addEventListener('click', function(e) {
                e.preventDefault();
                const rect = document.getElementById("MarketingTools").getBoundingClientRect();

                dropdownMenu.style.left = rect.right > window.innerWidth - 50 ? (rect.right - 225) + 'px' : rect.left + 'px';
                dropdownMenu.classList.toggle('show');
            });
            
            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!dropdown.contains(e.target)) {
                    dropdownMenu.classList.remove('show');
                }
            });
            
            // Close dropdown when pressing escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    dropdownMenu.classList.remove('show');
                }
            });
        }
    });
</script>