    </div>
}


@helper RenderMultipleSelect(string id, string label, IEnumerable<System.Web.Mvc.SelectListItem> dataList, bool hasAllOption = true, System.Web.Mvc.SelectListItem itemDefaultOption = null, string className = null)
{
    var displayText = Fanex.Affiliate.User.Core.Resources.Lang.NoneSelect;
    var selectedValues = dataList.Where(d => d.Selected).Select(d => d.Value);
    var selectedItemCount = selectedValues.Count();
    var hasSelectedItem = selectedItemCount >= 1;

    if (hasSelectedItem)
    {
        var selected = Fanex.Affiliate.User.Core.Resources.Lang.Selected.Replace("{0}", selectedItemCount.ToString());
        displayText = selectedItemCount == dataList.Count() ? itemDefaultOption?.Text ?? selected : selected;
    }
    <div class="form-group @className" id="@($"{id}")">
        <label>@label</label>
        <div id="@($"{id}-multiple-select")" class="multiple-select-container @(hasSelectedItem ? "" : "multiple-select-wrapper is-invalid")">
            <button id="@($"{id}-multiple-select-label")" type="button" class="form-control multiple-select-default multiple-select-label">
                <span id="@($"{id}-multiple-select-text-display")" class="text-display">@displayText</span>
                <b class="caret @($"{id}-multiple-select-caret")"></b>
            </button>
            <div id="@($"{id}-multiple-select-options-container")" class="multiple-select-default multiple-select-options-container" style="display:none;">
                @RenderOptionAll(id, dataList, hasAllOption, itemDefaultOption)
                <ul class="multiple-select-options">
                    @foreach (var item in dataList)
                    {
                        @RenderOption(id, item);
                    }
                </ul>
            </div>
        </div>
    </div>
}

@helper RenderOptionAll(string id, IEnumerable<System.Web.Mvc.SelectListItem> dataList, bool hasAllOption = true, System.Web.Mvc.SelectListItem itemDefaultOption = null)
{
    if (hasAllOption)
    {
        <ul class="multiple-select-options multiple-select-option-all">
            @if (itemDefaultOption is null)
            {
                var checkedItemCount = dataList.Count(d => d.Selected);
                var checkedAll = checkedItemCount == dataList.Count();

                <li class="multiple-select-item">
                    <input id="@(id)-multiple-select-option-all"
                           type="checkbox"
                           class="multiple-select-option-checkbox"
                           checked="@checkedAll" />
                    <label class="multiple-select-option-label" for="@(id)-multiple-select-option-all">
                        @Fanex.Affiliate.User.Core.Resources.Lang.All
                    </label>
                </li>
            }
            else
            {
                <li class="multiple-select-item">
                    <input id="@(id)-multiple-select-option-all"
                           type="checkbox"
                           class="multiple-select-option-checkbox"
                           checked="@itemDefaultOption.Selected" />
                    <label class="multiple-select-option-label" for="@(id)-multiple-select-option-all">
                        @itemDefaultOption.Text
                    </label>
                </li>
            }
        </ul>
    }
}

@helper RenderOption(string id, System.Web.Mvc.SelectListItem item)
{
    <li class="multiple-select-item">
        <input id="@($"{id}-{item.Value}")"
               type="checkbox"
               class="multiple-select-option-checkbox @($"{id}-multiple-select-option-checkbox")"
               value="@item.Value"
               checked="@item.Selected" />
        <label class="multiple-select-option-label mx-1" for="@($"{id}-{item.Value}")">@item.Text</label>
    </li>
}

@helper RenderAppContact(string language, string classLabel = "custom-lable")
{
    var firsAppContactList = Fanex.Affiliate.User.Core.Constants.AppContact.FirsAppContactList;
    var secondAppContactList = Fanex.Affiliate.User.Core.Constants.AppContact.SecondAppContactList;
    var thirdAppContactList = Fanex.Affiliate.User.Core.Constants.AppContact.ThirdAppContactList;
    var firstAppName = firsAppContactList[language];
    var firstAppNameTraslation = Fanex.Affiliate.User.Core.Resources.Lang.ResourceManager.GetString(firstAppName) ?? firstAppName;
    var firstAppPlaceHolder = Fanex.Affiliate.User.Core.Constants.AppContact.GetPlaceHolderByAppAndLanguage(firstAppName, language);
    var firstAppRegex = Fanex.Affiliate.User.Core.Constants.AppContact.GetRegexByAppAndLanguage(firstAppName, language);
    var hasTwoContactApp = secondAppContactList.ContainsKey(language);
    var hasThirdContactApp = thirdAppContactList.ContainsKey(language);

    <div class="form-group validate-group">
        <label for="ContactAppList[0].Value" class="col-sm-3 @classLabel">@(firstAppNameTraslation) <span class="red-warn">*</span></label>
        <input type="text" placeholder="@firstAppPlaceHolder" name="ContactAppList[0].Value" id="ContactAppList[0].Value" class="form-input" value=""
               data-val="true"
               data-val-required="@(firstAppNameTraslation)@Fanex.Affiliate.User.Core.Resources.Error.IsRequired"
               data-val-length="@(firstAppNameTraslation)@Fanex.Affiliate.User.Core.Resources.Error.InvalidLength"
               data-val-length-max="50"
               data-val-regex="@(firstAppNameTraslation)@Fanex.Affiliate.User.Core.Resources.Error.IsInvalid"
               data-val-regex-pattern="@firstAppRegex" />
        <div class="col-sm-offset-3 col-sm-9">
            <span class="field-validation-error validate-input hide"
                  data-valmsg-for="ContactAppList[0].Value" data-valmsg-replace="true"></span>
        </div>
        <input type="hidden" name="ContactAppList[0].Name" value="@firstAppName" />
        <input type="hidden" name="ContactAppList[0].Order" value="1" />
    </div>

    if (hasTwoContactApp)
    {
        var secondAppName = secondAppContactList[language];
        var secondAppNameTraslation = Fanex.Affiliate.User.Core.Resources.Lang.ResourceManager.GetString(secondAppName) ?? secondAppName;
        var secondAppPlaceHolder = Fanex.Affiliate.User.Core.Constants.AppContact.GetPlaceHolderByAppAndLanguage(secondAppName, language);
        var secondAppRegex = Fanex.Affiliate.User.Core.Constants.AppContact.GetRegexByAppAndLanguage(secondAppName, language);

        <div class="form-group validate-group">
            <label for="ContactAppList[1].Value" class="col-sm-3 @classLabel">@(secondAppNameTraslation)</label>
            <input type="text" placeholder="@secondAppPlaceHolder" name="ContactAppList[1].Value" id="ContactAppList[1].Value" class="form-input" value=""
                data-val="true"
                data-val-length="@(secondAppNameTraslation)@Fanex.Affiliate.User.Core.Resources.Error.InvalidLength"
                data-val-length-max="50"
                data-val-regex="@(secondAppNameTraslation)@Fanex.Affiliate.User.Core.Resources.Error.IsInvalid"
                data-val-regex-pattern="@secondAppRegex" />

            <div class="col-sm-offset-3 col-sm-9">
                <span class="field-validation-error validate-input hide"
                      data-valmsg-for="ContactAppList[1].Value" data-valmsg-replace="true"></span>
            </div>
            <input type="hidden" name="ContactAppList[1].Name" value="@secondAppName" />
            <input type="hidden" name="ContactAppList[1].Order" value="2" />
        </div>
        if (hasThirdContactApp)
        {
            var thirdAppName = thirdAppContactList[language];
            var thirdAppNameTraslation = Fanex.Affiliate.User.Core.Resources.Lang.ResourceManager.GetString(thirdAppName) ?? thirdAppName;
            var thirdAppPlaceHolder = Fanex.Affiliate.User.Core.Constants.AppContact.GetPlaceHolderByAppAndLanguage(thirdAppName, language);
            var thirdAppRegex = Fanex.Affiliate.User.Core.Constants.AppContact.GetRegexByAppAndLanguage(thirdAppName, language);

            <div class="form-group validate-group">
                <label for="ContactAppList[2].Value" class="col-sm-3 @classLabel">@(thirdAppNameTraslation)</label>
                <input type="text" placeholder="@thirdAppPlaceHolder" name="ContactAppList[2].Value" id="ContactAppList[2].Value" class="form-input" value=""
                    data-val="true"
                    data-val-length="@(thirdAppNameTraslation)@Fanex.Affiliate.User.Core.Resources.Error.InvalidLength"
                    data-val-length-max="50"
                    data-val-regex="@(thirdAppNameTraslation)@Fanex.Affiliate.User.Core.Resources.Error.IsInvalid"
                    data-val-regex-pattern="@thirdAppRegex" />

                <div class="col-sm-offset-3 col-sm-9">
                    <span class="field-validation-error validate-input hide"
                          data-valmsg-for="ContactAppList[2].Value" data-valmsg-replace="true"></span>
                </div>
                <input type="hidden" name="ContactAppList[2].Name" value="@thirdAppName" />
                <input type="hidden" name="ContactAppList[2].Order" value="3" />
            </div>
        }
    }
}

