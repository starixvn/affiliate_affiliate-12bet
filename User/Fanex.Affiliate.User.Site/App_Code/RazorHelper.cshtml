@helper RenderDropdownForMarketing(string id, string label, IEnumerable<System.Web.Mvc.SelectListItem> dataList, bool hasAllOption = true, bool isVisible = true)
{
    if (dataList != null)
    {
        <div class="form-group flex-sm-boostrap flex-center @(isVisible ? string.Empty : "hide")">
            <label class="control-label" for="@id">@label</label>
            <div class="control-input">
                <select class="form-control" id="@id">
                    @if (hasAllOption)
                    {
                        <option value="">@Fanex.Affiliate.User.Core.Resources.Lang.All</option>
                    }

                    @foreach (var item in dataList)
                    {
                        <option value="@item.Value" @(item.Selected ? "selected" : string.Empty)>@item.Text</option>
                    }
                </select>
            </div>
        </div>
    }
}

@helper RenderDropdownForMarketingHasNoInfo(string id, string label, IEnumerable<System.Web.Mvc.SelectListItem> dataList, bool hasAnyData = false)
{
    <div class="form-group flex-sm-boostrap flex-center">
