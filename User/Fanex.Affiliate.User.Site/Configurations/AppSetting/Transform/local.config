<?xml version="1.0" encoding="utf-8"?>
<appSettings xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <add key="Environment" value="LOCAL" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="ApplicationName" value="Legion.Aff.12B.User" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <add key="ExpirationCodeInMinute" value="5" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
  <!--Config Domain Mapper-->
  <add key="DefaultDomainSite" value="" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  <add key="DefaultDomainSite:PH" value="" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

</appSettings>