@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = Lang.MetaCommissionStructureTitle;
    ViewBag.MetaDescription = Lang.MetaCommissionStructureDescription;
    ViewBag.MetaKeywords = Lang.MetaCommissionStructureKeywords;
    ViewBag.HeaderTitle = Lang.CommissionStructureHeaderTitle;
}

@{
    string language = ViewBag.Language;
    string country = ViewBag.Country;

    var bannerSrc = Url.Content($"~/www/build/styles/Images/commission/top-banner/item/desktop.{language}");
    var mobileBannerSrc = Url.Content($"~/www/build/styles/Images/commission/top-banner/item/mobile.{language}");
}

@section alternateAndCanonicalTags{
    @RazorHelper.RenderAlternateAndCanonicalLinks("CommissionStructure", language)
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/commission-structure.css")" rel="stylesheet" />
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/commission-structure.js")
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.CommissionStructure</span>
    </div>

    <div class="swiper top-banner">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <a class="nounderline commission-structure-banner-tracking show-pc" target="_self" href="@Url.RenderLanguageContent("~/Promotion")">
                    <picture>
                        <source srcset="@(bannerSrc).webp?v=233098" type="image/webp" />
                        <source srcset="@(bannerSrc).jpg?v=233098" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(bannerSrc).jpg?v=233098" alt="12Bet Affiliate programs" />
                    </picture>
                </a>
                <a class="nounderline commission-structure-banner-tracking show-mobile" target="_self" href="@Url.RenderLanguageContent("~/Promotion")">
                    <picture>
                        <source srcset="@(mobileBannerSrc).webp?v=233098" type="image/webp" />
                        <source srcset="@(mobileBannerSrc).jpg?v=233098" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(mobileBannerSrc).jpg?v=233098" alt="12Bet Affiliate programs" />
                    </picture>
                </a>
            </div>
        </div>
        <div class="swiper-pagination"></div>
    </div>
    @Html.RenderPartialBySpecialCountry("~/Views/CommissionStructure/Partial/_Content", country, language)
    @RazorHelper.RenderMovingTopButton()
</div>