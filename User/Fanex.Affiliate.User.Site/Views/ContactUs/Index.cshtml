@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = Lang.MetaContactUsTitle;
    ViewBag.MetaDescription = Lang.MetaContactUsDescription;
    ViewBag.MetaKeywords = Lang.MetaContactUsKeywords;
    ViewBag.HeaderTitle = Lang.ContactUsHeaderTitle;
}

@using Fanex.Affiliate.User.Core.Utilities
@model Fanex.Affiliate.User.Core.DTO.UserInfo
@{
    var isShowFullInfo = !(bool)ViewBag.IsInternal;
    var name = Model != null ? $"{Model.FirstName.ReplaceAHalfOfString(isShowFullInfo)} {Model.LastName.ReplaceAHalfOfString(isShowFullInfo)}" : string.Empty;
    var affiliate = Model?.UserName;
    var email = Model?.Email;
    var appSetting = DependencyResolver.Current.GetService<IAppSetting>();
    var mailContact = appSetting.MailContact;
    var currentLanguage = ViewBag.CurrentLanguage;
}

@section alternateAndCanonicalTags{
    @RazorHelper.RenderAlternateAndCanonicalLinks("ContactUs", currentLanguage)
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/contact-us.css")
}

@section scripts{
    <script>
        var resourceLanguage = {
            generalError: '@Error.General'
        }
    </script>
    @Html.InlineScripts("~/www/build/js/contactus.js")
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.ContactUs</span>
    </div>

    <div class="block block-man-support ">
        <div class="page-container">
            <div class="img-support">
                <img class="img-responsive" src="~/www/build/styles/Images/contact-us/support_girl.svg" alt="12Bet contact support" />
            </div>
            <div class="date-time-info text-center">
                <p class="days">
                    @Lang.SupportDay
                </p>
                <p class="time">@Html.Raw(Lang.SupportTime)</p>
                <p class="subscribe">@Html.Raw(string.Format(Lang.SubscribeToOur, $"<a href=\"https://t.me/+3jGYqm3mAWNiNmE1\">{Lang.TelegramChannel}</a>"))</p>
            </div>
        </div>
    </div>

    <div class="block block-flag-contact">
        <div class="page-container">
            <div class="main-flag">
                <div class="items">
                    <div class="single-flag">
                        <img src="~/www/build/styles/Images/contact-us/markets/english.svg" alt="12Bet contact English support" />
                    </div>
                    <div class="info">
                        <p class="language">@Lang.EnglishSupport</p>
                        <a class="contact-info" href="https://t.me/official_12baff">
                            <img class="im-icon" src="~/www/build/styles/Images/contact-us/icons/telegram.svg" alt="Telegram" />
                            <div class="number">
                                <span>@("@Official_12BAff")</span>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="items">
                    <div class="single-flag">
                        <img src="~/www/build/styles/Images/contact-us/markets/china.svg" alt="12Bet contact China support" />
                    </div>
                    <div class="info">
                        <p class="language">@Lang.ChinaSupport</p>
                        <a class="contact-info" href="https://t.me/aff12bzhifeiji">
                            <img class="im-icon" src="~/www/build/styles/Images/contact-us/icons/telegram.svg" alt="Telegram" />
                            <div class="number">
                                <span>aff12bzhifeiji</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="block block-flag-contact">
        <div class="page-container">
            <div class="main-flag">
                <div class="items">
                    <div class="single-flag">
                        <img src="~/www/build/styles/Images/contact-us/markets/vietnam.svg" alt="12Bet contact Vietnam support" />
                    </div>
                    <div class="info">
                        <p class="language">@Lang.VietnamSupport</p>
                        <a class="contact-info" href="https://t.me/affvn12b">
                            <img class="im-icon" src="~/www/build/styles/Images/contact-us/icons/telegram.svg" alt="Telegram" />
                            <div class="number">
                                <span>@("@affvn12b")</span>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="items">
                    <div class="single-flag">
                        <img src="~/www/build/styles/Images/contact-us/markets/thailand.svg" alt="12Bet contact Thailand support" />
                    </div>
                    <div class="info">
                        <p class="language">@Lang.ThailandSupport</p>
                        <a class="contact-info" href="@("https://line.me/R/ti/p/@124asbwp?oat_content=url")">
                            <img class="im-icon" src="~/www/build/styles/Images/contact-us/icons/line.svg" alt="Line" />
                            <div class="number">
                                <span>@("@12affth")</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="block block-flag-contact">
        <div class="page-container">
            <div class="main-flag">
                <div class="items">
                    <div class="single-flag">
                        <img src="~/www/build/styles/Images/contact-us/markets/indonesian.svg" alt="12Bet contact Indonesia support" />
                    </div>
                    <div class="info">
                        <p class="language">@Lang.IndonesiaSupport</p>
                        <a class="contact-info info-whats-app" href="https://api.whatsapp.com/send?phone=639276842457">
                            <img class="im-whats-app" src="~/www/build/styles/Images/contact-us/icons/whatsapp.svg" alt="WhatsApp" />
                            <div class="number">
                                <p>WHATSAPP</p>
                                <p class="phone-number">+63 927 684 2457</p>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="items">
                    <div class="single-flag">
                        <img src="~/www/build/styles/Images/contact-us/markets/india.svg" alt="12Bet contact Indian support" />
                    </div>
                    <div class="info">
                        <p class="language">@Lang.IndianSupport</p>
                        <a class="contact-info info-whats-app" href="https://api.whatsapp.com/send?phone=639664523148">
                            <img class="im-whats-app" src="~/www/build/styles/Images/contact-us/icons/whatsapp.svg" alt="WhatsApp" />
                            <div class="number">
                                <p>WHATSAPP</p>
                                <p class="phone-number">+63 966 452 3148</p>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="block block-flag-contact">
        <div class="page-container">
            <div class="main-flag">
                <div class="items">
                    <div class="single-flag">
                        <img src="~/www/build/styles/Images/contact-us/markets/korea.svg" alt="12Bet contact Korea support" />
                    </div>
                    <div class="info">
                        <p class="language">@Lang.KoreaSupport</p>
                        <a class="contact-info" href="https://t.me/aff12kor">
                            <img class="im-icon" src="~/www/build/styles/Images/contact-us/icons/telegram.svg" alt="Telegram" />
                            <div class="number">
                                <span>@("@aff12kor")</span>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="items">
                    <div class="single-flag">
                        <img src="~/www/build/styles/Images/contact-us/markets/bangladesh.svg" alt="12Bet contact Bangladesh support" />
                    </div>
                    <div class="info">
                        <p class="language">@Lang.BangladeshSupport</p>
                        <a class="contact-info info-whats-app" href="https://api.whatsapp.com/send?phone=639664523148">
                            <img class="im-whats-app" src="~/www/build/styles/Images/contact-us/icons/whatsapp.svg" alt="WhatsApp icon" />
                            <div class="number">
                                <p>WHATSAPP</p>
                                <span class="phone-number">+63 966 452 3148</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="block block-contact-form">
        <div class="page-container">
            <div class="alert alert-success" role="alert" id="messageSuccess" style="display: none;">
                @Html.Raw(Lang.MessageSentReview.Replace("{br}", "<br>"))
            </div>

            <div id="mainContent">
                <h2 class="contact-title">
                    @Html.Raw(string.Format(Lang.ForInquiries, "<a href=\"https://t.me/official_12baff\">@Official_12BAff</a>", "<a href=\"mailto:" + mailContact + "\">" + mailContact + "</a>"))
                </h2>

                <form id="contactForm" class="form" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div class="alert alert-danger" role="alert" id="messageError" style="display: none"></div>
                    <div class="form-group form-columns form-columns-2">
                        <div class="items validate-group">
                            <input type="text" class="form-input" placeholder="@Lang.Name" name="Sender" id="Sender" value="@name" />
                            <div class="validate-input hide">
                                @Lang.NameIsInvalid
                            </div>
                        </div>
                        <div class="items">
                            <input type="text" class="form-input" placeholder="@Lang.Affiliate" name="Affiliate" id="Affiliate" value="@affiliate" />
                        </div>
                    </div>
                    <div class="form-group form-columns form-columns-2">
                        <div class="items validate-group">
                            <input type="text" class="form-input" placeholder="@Lang.Subject" name="Subject" id="Subject" />
                            <div class="validate-input hide">
                                @Lang.SubjectIsInvalid
                            </div>
                        </div>
                        <div class="items validate-group">
                            <input type="text" class="form-input" placeholder="@Lang.Email1" name="Email" id="Email" value="@(isShowFullInfo ? email : EmailHelper.HideEmailPart(email))" autocomplete="off" />
                            <div class="validate-input hide">
                                @Lang.EmailAddressIsInvalid
                            </div>
                        </div>
                    </div>
                    <div class="form-group form-columns form-columns-1">
                        <div class="items validate-group">
                            <textarea rows="4" cols="50" placeholder="@Lang.Comment" class="form-area" name="Content" id="Content"></textarea>
                            <div class="validate-input hide">
                                @Lang.CommentsIsInvalid
                            </div>
                        </div>
                    </div>
                    <div class="form-group form-columns form-columns-button">
                        <div class="items validate-group">
                            <input type="text" class="form-input" placeholder="@Lang.ValidationCodeLabel" name="Captcha" id="Captcha" />
                            <div class="validate-input hide">
                                @Lang.ErrmsgEntryValidCode
                            </div>
                        </div>
                        <div class="validation-value" id="contactUsCaptchaBtn">
                            <img id="contactUsCaptchaImg" src="@Url.RenderLanguageContent("~/Auth/CaptchaImage?type=1&_v="+DateTimeHelper.Gmt8Now.ToLongTimeString())" alt="captcha" />
                        </div>
                    </div>
                    <div class="form-group group-button">
                        <button class="custom-button" type="submit">@Lang.Submit</button>
                        <button class="custom-button" type="reset" id="btnReset">@Lang.Reset</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    @RazorHelper.RenderMovingTopButton()
</div>