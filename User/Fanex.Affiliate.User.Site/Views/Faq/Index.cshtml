@{
    ViewBag.Title = Lang.MetaFAQsTitle;
    ViewBag.MetaDescription = Lang.MetaFAQsDescription;
    ViewBag.MetaKeywords = Lang.MetaFAQsKeywords;
    ViewBag.HeaderTitle = Lang.FAQsHeaderTitle;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@{
    string language = ViewBag.Language;
    string country = ViewBag.Country;
}

@section alternateAndCanonicalTags{
    @RazorHelper.RenderAlternateAndCanonicalLinks("faq", language)
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/faq.css")
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/faq.js")
}

<div class="content">
    <div class="page-title">
        <span class="text">@Lang.Faqs</span>
    </div>

