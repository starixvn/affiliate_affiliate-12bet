@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
    ViewBag.Title = Lang.MetaHomeTitle;
    ViewBag.MetaDescription = Lang.MetaHomeDescription;
    ViewBag.MetaKeywords = Lang.MetaHomeKeywords;
    ViewBag.HeaderTitle = Lang.HomeHeaderTitle;
}

@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

@{
    var bannerSrc = Url.Content($"~/www/build/styles/Images/home/top-banner/item/desktop.{Model.Language}");
    var mobileBannerSrc = Url.Content($"~/www/build/styles/Images/home/top-banner/item/mobile.{Model.Language}");
}

@section alternateAndCanonicalTags{
    @RazorHelper.RenderAlternateAndCanonicalLinks("home", Model.Language)
}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/home.css")" rel="stylesheet" />
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/home.js")
}

<div class="content home-page">
    <div class="swiper top-banner">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <a class="nounderline home-banner-tracking show-pc" target="_self" href="@Url.RenderLanguageContent("~/Signup")">
                    <picture>
                        <source srcset="@(bannerSrc).webp?v=237309" type="image/webp" />
                        <source srcset="@(bannerSrc).jpg?v=237309" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(bannerSrc).jpg?v=237309" alt="12Bet Partner" />
                    </picture>
                </a>
                <a class="nounderline home-banner-tracking show-mobile" target="_self" href="@Url.RenderLanguageContent("~/Signup")">
                    <picture>
                        <source srcset="@(mobileBannerSrc).webp?v=237309" type="image/webp" />
                        <source srcset="@(mobileBannerSrc).jpg?v=237309" type="image/jpeg" />
                        <img class="img-item img-responsive" src="@(mobileBannerSrc).jpg?v=237309" alt="12Bet Partner" />
                    </picture>
                </a>
            </div>
        </div>
        <div class="swiper-pagination"></div>
    </div>

    @Html.RenderPartialBySpecialCountry("~/Views/Home/Partial/_Content", Model.CurrentCountry, Model.Language, Model)
    @RazorHelper.RenderMovingTopButton()
</div>

<input type="hidden" id="shortedLangCode" value="@Model.ShortedLanguageCode" />
<input type="hidden" id="isCLickedBannerLink" value="0" />
