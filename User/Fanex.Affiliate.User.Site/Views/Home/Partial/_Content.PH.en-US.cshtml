@model Fanex.Affiliate.User.Core.ViewModels.HomeViewModel

<div class="block block-why-become">
    <div class="page-container">
        <h2 class="block-title">
            <span class="why-become">why become a</span>
            <img src="~/www/build/styles/Images/home/why-become/title.svg" alt="title" />
            <span class="affiliate">Affiliate?</span>
        </h2>
        <div class="block-content">
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/highest.png" alt="12Bet High Commision logo" class="img-responsive" />
                <div class="heading-items">
                    <span class="wrap">EARN 50%</span> COMMISSION FOR ALL PRODUCTS
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/lifetime.png" alt="12Bet Life Revenue logo" class="img-responsive" />
                <div class="heading-items">
                    <span class="wrap">LIFETIME</span> REVENUES ON ALL REFERRED PLAYERS
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/advanced.png" alt="12Bet Marketing tools logo" class="img-responsive" />
                <div class="heading-items">
                    <span class="wrap">ADVANCED</span> MARKETING & ANALYTICAL TOOLS
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/workat.png" alt="12Bet Work Anywhere logo" class="img-responsive" />
                <div class="heading-items">
                    <span class="wrap">WORK AT YOUR</span> OWN TIME & BE YOUR OWN BOSS
                </div>
            </div>
            <div class="items">
                <img src="~/www/build/styles/Images/home/why-become/17years.png" alt="17 years-12Bet" class="img-responsive" />
                <div class="heading-items">
                    <span class="wrap">17 YEARS OF</span> EXPERIENCE IN GAMING<br>INDUSTRY
                </div>
            </div>
        </div>
    </div>
</div>

<div class="block block-about">
    <div class="page-container">
        <div class="group-block">
            <h2 class="block-title">
                About
                <img src="~/www/build/styles/Images/home/why-become/title-about.svg" alt="title-about" />
                Affiliate
            </h2>
            <div class="block-content">
                <p>As a the prominent sportsbook in the Philippines, 12BET has earned a reputation as a global market leader, offering competitive odds and being ranked as the 17th Best Online Gaming Operator worldwide.</p>
                <p>We are excited to extend a warm welcome to all potential affiliates to join our affiliate program, where you can earn generous commissions from promoting all of our 12BET products.</p>
            </div>
        </div>
    </div>
</div>

<div class="block block-partnership">
    <div class="page-container">
        <h2 class="block-title fill-color">
            <span class="block-mb">PARTNERSHIP AND</span> SPONSORSHIP HISTORY
        </h2>
        @{ Html.RenderPartial("~/Views/Home/Partial/_PartnershipContentBlock.cshtml"); }
    </div>
</div>

<div class="block block-get-started">
    <div class="page-container">
        <h2 class="block-title">
            Get Started
        </h2>
        <div class="wrapper-block">
            <div class="block-content">
                <div class="items">
                    <span class="number">1</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/sign-up.svg" alt="Free 12Bet registration" />
                    </div>
                    <div class="heading-items">
                        SIGN UP
                    </div>
                    <div class="description">
                        Instant registration Sign up free today
                    </div>
                </div>
                <div class="items">
                    <span class="number">2</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/approved.svg" alt="12Bet hassle free safe approval" />
                    </div>
                    <div class="heading-items">
                        approved
                    </div>
                    <div class="description">
                        Hassle free Safe place gain money
                    </div>
                </div>
                <div class="items">
                    <span class="number">3</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/promote.svg" alt="Promote 12Bet game" />
                    </div>
                    <div class="heading-items">
                        promote
                    </div>
                    <div class="description">
                        Start Promoting Grab your tracker
                    </div>
                </div>
                <div class="items">
                    <span class="number">4</span>
                    <div class="icon">
                        <img src="~/www/build/styles/Images/home/get-started/earning.svg" alt="Earn from 12Bet" />
                    </div>
                    <div class="heading-items">
                        earning
                    </div>
                    <div class="description">
                        Make money Enjoy earning from Day 1
                    </div>
                </div>
            </div>
            <div class="text-center">
                <a href="@Url.RenderLanguageContent(Model.SignUpLink)" class="custom-button">@Lang.JoinNow</a>
            </div>
        </div>
    </div>
</div>

<div class="block block-our-product">
    <div class="page-container">
        <h2 class="block-title fill-color">
            OUR PRODUCTS <span class="show-pc">AND PROVIDERS</span>
        </h2>
        @{ Html.RenderPartial("~/Views/Home/Partial/_OurProductContentBlock.PH.en-US.cshtml", Model.Language); }
    </div>
</div>

<div class="block block-faq">
    <div class="page-container">
        <h2 class="block-title fill-color">
            faq
        </h2>
        <div class="block-content">
            <div class="group-faq">
                <div class="number">
                    01
                </div>
                <div class="question">
                    <div class="title">
                        <span>General</span>
                    </div>
                    <span class="button-toggle"></span>
                </div>
                <div class="anwser">
                    <div class="anwser-heading">What is 12BET Affiliate Program?</div>
                    <div class="anwser-text">
                        12BET Affiliate Program is a partnership program where you will earn commissions based on the wagering activity of players that you refer to 12BET.com from your Website via online or offline via referrals.
                    </div>
                    <div class="anwser-heading">How do I sign up with 12BET Affiliate Program?</div>
                    <div class="anwser-text">
                        The 12BET Affiliate Program is free to join. Simply fill out our application form and you will be contacted within 3 business days regarding your acceptance into the program. If your application is accepted, you will receive an email containing your unique affiliate ID, giving you access to banners, text links, and other content and marketing tools to add to your website.
                    </div>
                    <div class="anwser-heading">What if I don't have a Website, can I still join?</div>
                    <div class="anwser-text">
                        Yes, now you can! If you think you have the contacts, you can easily create your own personalized page on our special Affiliate section and upload on it any of the approved marketing ideas or sports messages. Once done, you can immediately send the page link to any of your friends or contacts that are interested in sports or sports betting and when they click on the link, they become your referred members! For more details, please write to us at affiliates@12csd.com.
                    </div>
                    <div class="text-center">
                        <a href="@Url.RenderLanguageContent("~/FAQ")" class="custom-button">More FAQS</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>