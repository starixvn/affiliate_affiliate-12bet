@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/notify.css")
}


<div class="page-notify">
    <div class="page-container">
        <div class="main-notify">
            <div class="column column-left">
                <h2 class="title-notify">
                    <span class="title-hightlight">Sorry!</span> The system is <br />
                    not available
                </h2>
                <img src="~/www/build/styles/Images/notify/error.svg" alt="Sports" class="main-img">
            </div>
            <div class="column column-right">
                <ul class="cont">
                    <li>
                        <img src="~/www/build/styles/Images/langs/en.svg" alt="eng" />
                        We are sorry. The system is currently unavailable.<br />
                        Please try again later or contact administrator.
                    </li>
                    <li>
                        <img src="~/www/build/styles/Images/langs/cs.svg" alt="cs" />
                        很抱歉，目前该系统无法使用。<br />
                        请稍后再试，或联系管理员。
                    </li>
                    <li>
                        <img src="~/www/build/styles/Images/langs/id.svg" alt="id" />
                        Mohon Maaf. Saat ini sistem tidak tersedia.<br />
                        Silakan coba beberapa saat lagi atau hubungi Administrator.
                    </li>
                    <li>
                        <img src="~/www/build/styles/Images/langs/kh.svg" alt="kh" />
                        ​សូមអភ័យទោស សំរាប់ប្រព័ន្ធគឺមិនអាចប្រើប្រាស់បានទេនៅពេលនេះ។<br />
                        សូមព្យាយាមម្តងទៀតនៅពេលក្រោយ ឬទាក់ទងមកកាន់អ្នកគ្រប់គ្រង។
                    </li>
                    <li>
                        <img src="~/www/build/styles/Images/langs/ko.svg" alt="ko" />
                        죄송합니다. 현재 시스템을 이용할 수 없습니다.<br />
                        잠시 후 다시 시도하시거나 관리자에게 문의하십시오.
                    </li>
                    <li>
                        <img src="~/www/build/styles/Images/langs/th.svg" alt="th" />
                        ขออภัยค่ะ ขณะนี้ระบบไม่สามารถใช้งานได้<br />
                        โปรดลองอีกครั้งในภายหลังหรือติดต่อผู้ดูแลระบบ
                    </li>
                    <li>
                        <img src="~/www/build/styles/Images/langs/vn.svg" alt="vn" />
                        Chúng tôi rất tiếc. Hệ thống hiện không khả dụng.<br />
                        Vui lòng thử lại sau hoặc liên hệ với quản trị viên.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>




