@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/notify.css")
}


<div class="page-notify">
    <div class="page-container">
        <div class="main-notify">
            <div class="column column-left">
                <h2 class="title-notify">
                    <span class="title-hightlight">404</span>: Page not found!!
                </h2>
                <img src="~/www/build/styles/Images/notify/404.svg" alt="Sports" class="main-img">
            </div>
            <div class="column column-right">
                <ul class="cont">
                    <li>
                        <img src="~/www/build/styles/Images/langs/en.svg" alt="eng" />
                        Sorry, the page you were looking for appears to have been moved, deleted or does not exist.
                    </li>
                    <li>
                        <img src="~/www/build/styles/Images/langs/cs.svg" alt="cs" />
                        很抱歉，您要找的页面已经被移动、删除或不存在。
                    </li>
                    <li>
                        <img src="~/www/build/styles/Images/langs/id.svg" alt="id" />
                        Maaf, halaman yang Anda cari tampaknya telah dipindahkan, dihapus, atau tidak ada.
                    </li>
                    <li>
                        <img src="~/www/build/styles/Images/langs/kh.svg" alt="kh" />
                        សូមអភ័យទោស ទំព័រដែលអ្នកកំពុងស្វែងរកត្រូវបានដកចេញ លុប ឬមិនមានទៀតនោះទេ។
                    </li>
                    <li>
                        <img src="~/www/build/styles/Images/langs/ko.svg" alt="ko" />
                        죄송합니다. 찾고 계신 페이지가 이동 또는 삭제되었거나 존재하지 않는 것 같습니다.
                    </li>
                    <li>
                        <img src="~/www/build/styles/Images/langs/th.svg" alt="th" />
                        ขออภัยค่ะ หน้าที่คุณกำลังค้นหาถูกย้าย ถูกลบ หรือไม่มีอยู่จริง
                    </li>
                    <li class="end">
                        <img src="~/www/build/styles/Images/langs/vn.svg" alt="vn" />
                        Xin lỗi, trang này dường như đã bị di chuyển, bị xóa hoặc không tồn tại.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

