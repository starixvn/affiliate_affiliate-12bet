@{
    ViewBag.Title = Lang.MetaProductTitle;
    ViewBag.MetaDescription = Lang.MetaProductDescription;
    ViewBag.MetaKeywords = Lang.MetaProductKeywords;
    ViewBag.HeaderTitle = Lang.ProductHeaderTitle;
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@{
    string language = ViewBag.Language;
    string country = ViewBag.Country;
}

@section alternateAndCanonicalTags{
    @RazorHelper.RenderAlternateAndCanonicalLinks("product", language)
}

@section styles{
    @Html.InlineStyles("~/www/build/styles/css/products.css")
}

@section scripts{
    @Html.InlineScripts("~/www/build/js/pages/products.js")
}

@if (SystemLanguage.SpecialCountry.ContainsKey(country))
{
    @Html.RenderPartialBySpecialCountry("~/Views/Product/_Product", country, language, language)
}
else
{
    Html.RenderPartial("~/Views/Product/_Product.cshtml", language);
}