@model Fanex.Affiliate.User.Core.MetalModels.Email.NewPasswordEmailParam
@{
    var userInfo = Model.User;
}

<table>
    <tr>
        <td>
            <p style="color: #313131; margin: 0; line-height: 1.5">
                Dear @userInfo.FirstName,<br /><br />

                As you have requested, we provide you a new password. Your new account information is as below:<br /><br />

                --------------------------------------------------------<br />
                User Name: @userInfo.UserName<br />
                Password: @Model.NewPassword<br />
                --------------------------------------------------------<br /><br />

                However, you can visit <a href="@Model.RootDomain">@Model.RootDomain</a> to change your password at anytime<br /><br />

                Have a great day!<br /><br />

                Best regards,<br /><br />
            </p>
        </td>
    </tr>
</table>
@Raw(Model.ContactInfo)