@using Fanex.Affiliate.User.Core.CoreService
@using Fanex.Affiliate.User.Core.BusinessService
@using Fanex.Affiliate.User.Core.Extensions

@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var settingService = DependencyResolver.Current.GetService<IAppSetting>();
    var systemsService = DependencyResolver.Current.GetService<ISystemService>();
    var languageList = systemsService.GetSupportedLanguages();
    var currentLanguage = sessionService.CurrentLanguage;
    var languageNativeName = languageList.FirstOrDefault(l => l.Code.Equals(currentLanguage))?.NativeName;
    var isLoggedIn = HttpContext.Current.User.Identity.IsAuthenticated && sessionService.UserSession != null;

    var isProduction = settingService.IsProduction;
    var shouldApplyGoogleTag = HttpContext.Current.Request.Url.Host.MatchWith("www.12betaffiliate.com");

    var targetCountryLanguages = systemsService.GetTargetCountryLanguages();

    var currentCountry = sessionService.CurrentCountry;
    var isSpecialCountry = SystemLanguage.SpecialCountry.ContainsKey(currentCountry);

    var year = DateTimeHelper.Gmt8CurrentYear;
    var ageText = isSpecialCountry ? "21+" : "18+";
    var copyright = Lang.Copyright
        .Replace("{0}", year.ToString())
        .Replace("18+", ageText);
}

<!DOCTYPE html>
<html lang="@SystemLanguage.GetSEOHtmlTagLangAttribute()">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    @*<meta name="viewport" content="width=device-width, initial-scale=1">*@
    <meta name="viewport" content="width=device-width, initial-scale=1 , user-scalable=no">
    <title>@(string.IsNullOrEmpty(ViewBag.Title) ? Lang.MetaHomeTitle : ViewBag.Title)</title>
    <link rel="icon" href="~/favicon.ico?v=1">
    <meta name="google-site-verification" content="iFkj5nsimoERnX2jd-9krswREsacSaFCr3Q22CJtQe0" />
    <meta name="msvalidate.01" content="D40D4C0F9E67ABAAAFA183F5D313FEFD" />
    <meta name="description" content="@(string.IsNullOrEmpty(ViewBag.MetaDescription) ? Lang.MetaHomeDescription : ViewBag.MetaDescription)" />
    <meta name="keywords" content="@(string.IsNullOrEmpty(ViewBag.MetaKeywords) ? Lang.MetaHomeKeywords : ViewBag.MetaKeywords)" />
    <meta name="robots" content="index,follow,archive" />
    <meta name="title" content="@Lang.MetaTitle" />

    @RenderSection("alternateAndCanonicalTags", required: false)

    <script src="~/www/build/js/lib/jquery-3.3.1.min.js"></script>
    <script>
        window.jQuery || document.write('\x3Cscript src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous">\x3C/script>')
    </script>
    <script src="~/www/build/js/lib/bootstrap.min.js"></script>

    <link href="~/www/build/styles/css/bootstrap-3.3.7.min.css" rel="stylesheet" />
    <link href="~/www/build/styles/fonts/materialdesignicons/font.min.css" rel="stylesheet" type="text/css" />

    @if (currentLanguage == SystemLanguage.VietNamLanguageCode)
    {
        <link href="~/www/build/styles/fonts/tahoma/font.min.css" rel="stylesheet" />
    }
    else
    {
        if (currentLanguage == SystemLanguage.ChineseLanguageCode)
        {
            <link href="~/www/build/styles/fonts/noto-sans-sc/font.min.css" rel="stylesheet" />
        }
        else
        {
            <link href="~/www/build/styles/fonts/montserrat/font.min.css" rel="stylesheet" />
        }
    }
    <link href="~/www/build/styles/fonts/myriadPro/font.min.css" rel="stylesheet" />
    <link href="@Url.RenderLink("~/www/build/styles/css/main.css")" rel="stylesheet" />
    @RenderSection("styles", required: false)

    @if (isProduction)
    {
        if (shouldApplyGoogleTag)
        {
            <!-- Google Tag Manager -->
            <script>
                (function (w, d, s, l, i) {
                    w[l] = w[l] || []; w[l].push({
                        'gtm.start': new Date().getTime(), event: 'gtm.js'
                    });

                    var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
                    j.async = true;
                    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                    f.parentNode.insertBefore(j, f);
                })(window, document, 'script', 'dataLayer', 'GTM-THVXX27Z');
            </script>
            <!-- End Google Tag Manager -->
        }

        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-9S16RTPV0W"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }

            gtag('js', new Date());
            gtag('config', 'G-9S16RTPV0W');
        </script>
    }
</head>
<body class="@RenderSection("afterLogin", required: false) @currentLanguage">
    @if (isProduction && shouldApplyGoogleTag)
    {
        <!-- Google Tag Manager (noscript) -->
        <noscript>
            <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-THVXX27Z" height="0" width="0" style="display:none;visibility:hidden"></iframe>
        </noscript>
        <!-- End Google Tag Manager (noscript) -->
    }

    <div class="header">
        <div class="header-top">
            <div class="page-container">
                <div class="logo-lang">
                    <div class="logo">
                        <a href="@Url.RenderLanguageContent("~/Home")">
                            <img class="12b" src="~/www/build/styles/Images/logo/@(currentLanguage).png?v=012" alt="logo" width="230" />
                        </a>
                    </div>
                    <div class="login">
                        <div class="user-signup">
                            @{Html.RenderAction("AuthenticationForm", "Auth", new { v = DateTimeHelper.UtcNow.Ticks });}
                            <div class="language-container">
                                <div class="language-selection">
                                    <button class="select-language" id="selectedLanguage">
                                        <span>
                                            <i class="flag flag-@currentLanguage"></i>
                                            <span class="name-lang">@(languageNativeName)</span>
                                        </span>
                                        <i class="caret"></i>
                                    </button>
                                    <div class="language-list-wrapper" id="languageList">
                                        <ul>
                                            @foreach (var country in targetCountryLanguages)
                                            {

                                                <li class="country-item">
                                                    <i class="country-item-col-1 flag flag-@country.Key"></i>
                                                    <div class="country-item-col-2">
                                                        <p class="country-name @(country.Key == sessionService.CurrentCountry ? "text-bold" : "")">@country.Value[0].TargetCountryName</p>
                                                        <div class="language-options">
                                                            @foreach (var lang in country.Value)
                                                            {
                                                                <span class="language-item @(sessionService.CurrentLanguage == lang.Code && country.Key == sessionService.CurrentCountry ? "highlight" : "")" data-target-country-code="@country.Key" data-option="@lang.ShortedCode">
                                                                    @lang.NativeName
                                                                </span>
                                                                if (lang != country.Value.Last())
                                                                {
                                                                    <span class="separator">|</span>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="header-bottom">
            <div class="navbar">
                <div class="@RenderSection("classNav", required: false)">
                    <div class="navbar-header">
                        <button type="button" id="menuMobileBtn" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1" aria-expanded="false">
                            <span class="sr-only">Toggle navigation</span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                            <span class="icon-bar"></span>
                        </button>
                    </div>
                    <div class="collapse navbar-collapse menu" id="bs-example-navbar-collapse-1">
                        <ul class="nav navbar-nav">
                            @{
                                var controllerName = ViewContext.RouteData.Values["Controller"].ToString();
                            }
                            <li>
                                <a class="menu-item @(controllerName == "Home" ? "active" : string.Empty)" href="@Url.RenderLanguageContent("~/Home")">
                                    @Lang.Home
                                </a>
                            </li>
                            <li>
                                <a class="menu-item @(controllerName == "CommissionStructure" ? "active" : string.Empty)" href="@Url.RenderLanguageContent("~/CommissionStructure")">
                                    @Lang.CommissionStructure
                                </a>
                            </li>
                            <li>
                                <a class="menu-item @(controllerName == "Product" ? "active" : string.Empty)" href="@Url.RenderLanguageContent("~/Product")">
                                    @Lang.Product
                                </a>
                            </li>
                            <li>
                                <a class="menu-item @(controllerName == "TermAndCondition" ? "active" : string.Empty)" href="@Url.RenderLanguageContent("~/TermAndCondition")">
                                    @Lang.TermAndCondition
                                </a>
                            </li>
                            <li>
                                <a class="menu-item @(controllerName == "FAQ" ? "active" : string.Empty)" href="@Url.RenderLanguageContent("~/FAQ")">
                                    @Lang.Faqs
                                </a>
                            </li>
                            <li>
                                <a class="menu-item @(controllerName == "Promotion" ? "active" : string.Empty)" href="@Url.RenderLanguageContent("~/Promotion")">
                                    @Lang.Promotion
                                </a>
                            </li>
                            <li>
                                <a class="menu-item @(controllerName == "ContactUs" ? "active" : string.Empty)" href="@Url.RenderLanguageContent("~/ContactUs")">
                                    @Lang.ContactUs
                                </a>
                            </li>
                        </ul>
                        @if (isLoggedIn)
                        {
                            <div class="logout-btn">
                                <a href="@Url.RenderLanguageContent("~/Auth/SignOut/")" id="btnLogoutMobile">logout</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        @RazorHelper.RenderHotNews()
    </div>

    <div class="main-container">
        @RenderBody()
    </div>

    <div class="footer">
        <div class="page-container">
            <div class="footer-img">
                <div class="img-top">
                    <a class="item">
                        <img width="250" src="~/www/build/styles/Images/footer/cr-nosponsor.png?v=012" alt="cr-nosponsor" />
                    </a>
                </div>
                @if (!isSpecialCountry)
                {
                    <div class="img-bottom">
                        <a class="item">
                            <img width="28" src="@Url.Content("~/www/build/styles/Images/footer/cr-18.png")" alt="cr-18-logo" />
                        </a>
                        <a class="item">
                            <img src="@Url.Content("~/www/build/styles/Images/footer/cr-gamleaware.png")" alt="cr-gamleaware-logo" />
                        </a>
                        <a class="item">
                            <img src="@Url.Content("~/www/build/styles/Images/footer/cr-tst.png")" alt="cr-tst-logo" />
                        </a>
                        <a class="item">
                            <img src="@Url.Content("~/www/build/styles/Images/footer/cr-thawte.png")" alt="cr-thawte-logo" />
                        </a>
                        <a class="item">
                            <img src="@Url.Content("~/www/build/styles/Images/footer/cr-playtech.png")" alt="cr-playtech-logo" />
                        </a>
                        <a class="item">
                            <img src="@Url.Content("~/www/build/styles/Images/footer/cr-safe&secure.png")" alt="cr-safe&secure-logo" />
                        </a>
                    </div>
                }
            </div>
            <div class="footer-text">
                @copyright
            </div>
        </div>
    </div>

    <div id="contactAffManager"></div>

    <div class="blocker" id="blocker" style="display: none;">
        <div class="sk-cube-grid">
            <div class="sk-cube sk-cube1"></div>
            <div class="sk-cube sk-cube2"></div>
            <div class="sk-cube sk-cube3"></div>
            <div class="sk-cube sk-cube4"></div>
            <div class="sk-cube sk-cube5"></div>
            <div class="sk-cube sk-cube6"></div>
            <div class="sk-cube sk-cube7"></div>
            <div class="sk-cube sk-cube8"></div>
            <div class="sk-cube sk-cube9"></div>
        </div>
    </div>

    <input type="hidden" id="RootUrl" value="@Url.Content("~")" />
    <input type="hidden" id="RootLangUrl" value="@Url.RenderLanguageContent("~/")" />
    <input type="hidden" id="Language" value="@currentLanguage" />
    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())

    <script>
        window.Lang = {
            All: '@Lang.All',
            ServerError: '@Lang.ServerError'
        }
    </script>

    @Html.InlineScripts("~/www/build/js/lib/modernizr-webp.js")
    @Html.InlineScripts("~/www/build/js/jquery.extension.js")
    <script src="@Url.RenderLink("~/www/build/js/site.js")"></script>
    <script src="@Url.RenderLink("~/www/build/js/layout.js")"></script>

    @if (!settingService.IsLocal && isLoggedIn)
    {
        <script src="@Url.RenderLink("~/www/build/js/recheckin.js")"></script>
    }

    @RenderSection("scripts", required: false)
</body>
</html>