
@using Fanex.Affiliate.User.Core.CoreService
@using Fanex.Affiliate.User.Core.BusinessService

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var newsLetterService = DependencyResolver.Current.GetService<INewsLetterService>();
    var groupName = sessionService.UserSession.GroupName;
    var hasTurnOverPermission = ClaimUtitlity.HasClaim(ClaimConstant.TurnOverType);
    var hasPaymentRequestPermission = ClaimUtitlity.HasClaimOnlyInternalLogin(ClaimConstant.PaymentRequest);
    var hasCommissionReportPermission = ClaimUtitlity.HasClaimOnlyInternalLogin(ClaimConstant.CommissionReport);
    var isIndiaAffiliate = string.Equals(SystemLanguage.IndiaLanguageCode, sessionService.UserSession.PreferredLanguage, StringComparison.OrdinalIgnoreCase) && !sessionService.IsInternal;
    var isShowNewsLetterTab = Helper.IsAsianAffType(sessionService.UserSession.AffType) && newsLetterService.HasNewCurrentTime();
    var isShowOfferTab = Helper.IsAsianAffType(sessionService.UserSession.AffType) && sessionService.UserSession.OfferPageId != 0;
}
@section afterLogin{after-login}

@section styles{
    <link href="@Url.RenderLink("~/www/build/styles/css/important-notice-closev1.css")" rel="stylesheet" />

    @RenderSection("styles", required: false)
}

@section scripts{
    <script>
        window.Permission = {
            HasTurnOverPermission: '@hasTurnOverPermission'.toLowerCase() === 'true',
            IsIndiaAffiliate: '@isIndiaAffiliate'.toLowerCase() === 'true'
        }
    </script>
    <script src="@Url.RenderLink("~/www/build/js/pages/important-notice-closev1.js")"></script>
    @RenderSection("scripts", required: false)
}

<div class="main after-login">
    <div class="content-menu">
        <ul class="menu list-unstyled" id="mainMenu">
            <li><a class="menu-item" id="menuAccountOverview" href="@Url.RenderLanguageContent("~/UserPanel/Main/#AccountOverview")">@Lang.AccOverview</a></li>
            @if (string.Equals(groupName, CommGroupName.KoreanAgentComm))
            {
                <li><a class="menu-item @(ViewContext.RouteData.Values["Controller"].ToString() == "Member" ? "active" : string.Empty)" id="menuYourCustomer" href="@(Url.RenderLanguageContent("~/UserPanel/Member/Index"))">@Lang.YourCustomers</a></li>
            }
            <li><a class="menu-item" id="menuStatementHistory" href="@Url.RenderLanguageContent("~/UserPanel/Main/#StatementHistory")">@Lang.StatementHistory</a></li>
            <li><a class="menu-item" id="menuMyAccount" href="@Url.RenderLanguageContent("~/UserPanel/Main/#MyAccount")">@Lang.MyAccount</a></li>
            @if (hasPaymentRequestPermission)
            {
                <li><a class="menu-item" id="menuPaymentRequest" href="@Url.RenderLanguageContent("~/UserPanel/Main/#PaymentRequest")">@Lang.PaymentRequest</a></li>
            }
            @if (hasCommissionReportPermission)
            {
                <li><a class="menu-item" id="menuCommissionReport" href="@Url.RenderLanguageContent("~/UserPanel/Main/#CommissionReport")">@Lang.CommissionReport</a></li>
            }
            <li class="parent">
                <a class="menu-item" href="javascript:;">@Lang.Statistics <i class="caret"></i></a>
                <ul class="menu submenu-container list-unstyled">
                    <li><a class="menu-item" id="menuReferrersStatistics" href="@Url.RenderLanguageContent("~/UserPanel/Main/#ReferrersStatistics")">@Lang.Referrals</a></li>
                    <li><a class="menu-item" id="menuLandingPageStatistics" href="@Url.RenderLanguageContent("~/UserPanel/Main/#LandingPageStatistics")">@Lang.LandingPages</a></li>
                </ul>
            </li>
            @if (isShowNewsLetterTab)
            {
                <li><a class="menu-item" id="menuNewsLetter" href="@Url.RenderLanguageContent("~/UserPanel/Main/#NewsLetter")">@Lang.WhatNewThisMonth</a></li>
            }
            @if (isShowOfferTab)
            {
                <li><a class="menu-item" id="menuOffersForMe" href="@Url.RenderLanguageContent("~/UserPanel/Main/#OffersForMe")">@Lang.OffersForMe</a></li>
            }
        </ul>
    </div>

    <div class="main-content">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </div>
</div>
<!-- Modal Close V1 -->
<div class="modal fade" id="importantNoticeModal" tabindex="-1" aria-labelledby="importantNoticeModalLabel">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-icon">!</span>
                <h5 class="modal-title" id="importantNoticeModalLabel">
                    @Lang.ImportantNoticeTitle
                </h5>
                <button type="button" class="close-btn" id="closeModal">×</button>
            </div>
            <div class="modal-body">
                <p>
                    @Html.Raw(Lang.ImportantNoticeContent)
                </p>
            </div>
        </div>
    </div>
</div>