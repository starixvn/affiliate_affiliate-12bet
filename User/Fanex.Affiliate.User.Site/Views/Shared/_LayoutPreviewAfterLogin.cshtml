@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var controllerName = ViewContext.RouteData.Values["Controller"].ToString();
}

@section styles{
    @RenderSection("styles", required: false)
}

@section scripts{
    @RenderSection("scripts", required: false)
}

<div class="main after-login">
    <div class="content-menu">
        <ul class="menu list-unstyled" id="mainMenu">
            <li><a class="menu-item" id="menuAccountOverview" href="javascript:void(0)">@Lang.AccOverview</a></li>
            <li><a class="menu-item" id="menuYourCustomer" href="javascript:void(0)">@Lang.YourCustomers</a></li>
            <li><a class="menu-item" id="menuStatementHistory" href="javascript:void(0)">@Lang.StatementHistory</a></li>
            <li><a class="menu-item" id="menuMyAccount" href="javascript:void(0)">@Lang.MyAccount</a></li>
            <li><a class="menu-item" id="menuPaymentRequest" href="javascript:void(0)">@Lang.PaymentRequest</a></li>
            <li><a class="menu-item" id="menuRevenueReport" href="javascript:void(0)">@Lang.CommissionReport</a></li>
            <li class="parent">
                <a class="menu-item" href="javascript:;">CPA Report<i class="caret"></i></a>
                <ul class="menu submenu-container list-unstyled">
                    <li><a class="menu-item" id="menuPlayerCPAReport" href="javascript:void(0)">Affiliate CPA Report</a></li>
                </ul>
            </li>
            <li class="parent">
                <a class="menu-item" href="javascript:;">@Lang.Statistics <i class="caret"></i></a>
                <ul class="menu submenu-container list-unstyled">
                    <li><a class="menu-item" id="menuReferrersStatistics" href="javascript:void(0)">@Lang.Referrals</a></li>
                    <li><a class="menu-item" id="menuLandingPageStatistics" href="javascript:void(0)">@Lang.LandingPages</a></li>
                    <li><a class="menu-item" id="menuMarketingLinkStatistics" href="javascript:void(0)">@Lang.ChannelStatistics</a></li>
                </ul>
            </li>
        </ul>
    </div>

    <div class="main-content">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </div>
</div>