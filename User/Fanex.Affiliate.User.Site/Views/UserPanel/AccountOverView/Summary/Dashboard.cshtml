@using Fanex.Affiliate.User.Core.CoreService
@model Fanex.Affiliate.User.Core.DTO.UserPanel.AccountOverview.OverviewSummary

@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
    var isAffOfNoCommissionCPAGroup = string.Equals(sessionService.UserSession?.GroupName, "NoCommission-CPA", StringComparison.OrdinalIgnoreCase);
}

<div class="dashboard-section-col">
    <span class="my-account">@Lang.MyAccount</span>
    <div class="group group-one">
        <div class="img-icon">
            <img class="img-responsive" src="~/www/build/styles/Images/account-overview/new-sign-up.svg" alt="New Signup icon" />
        </div>
        <div class="info-panel">
            <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.NewSignupAndDeposited</span>
            <span class="info-panel-content">@($"{Model.Signups}/{Model.DepositedMembers}")</span>
        </div>

        @if (isAffOfNoCommissionCPAGroup)
        {
            <div class="info-panel">
                <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.ActivePlayers</span>
                <span class="info-panel-content">@($"{Model.ActivePlayers}")</span>
            </div>
        }
        else
        {
            <div class="info-panel">
                <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.ActivePlayersAndQualified</span>
                <span class="info-panel-content">@($"{Model.ActivePlayers}/{Model.QualifiedMember}")</span>
            </div>
        }
    </div>
    <div class="group group-two">
        <div class="img-icon">
            <img class="img-responsive" src="~/www/build/styles/Images/account-overview/commission.svg" alt="Commission icon" />
        </div>
        <div class="info-panel">
            <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.RevenueShare</span>
            <span class="info-panel-content">@Model.Commission.ToStringMoneyWithSymbol("$")</span>
        </div>
        <div class="info-panel">
            <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.BalForward</span>
            <span class="info-panel-content">@Model.BalanceBroughtForward.ToStringMoneyWithSymbol("$")</span>
        </div>
    </div>
    <div class="group group-two">
        <div class="img-icon">
            <img class="img-responsive" src="~/www/build/styles/Images/account-overview/total-deposit.svg" alt="Total Deposit icon" />
        </div>
        <div class="info-panel">
            <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.TotalDeposit/@Lang.FdmDeposit</span>
            <span class="info-panel-content">@Model.Deposit.ToStringMoneyWithSymbol("$")/@Model.FdmDeposit.ToStringMoneyWithSymbol("$")</span>
        </div>
        <div class="info-panel">
            <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.NetRevenue</span>
            <span class="info-panel-content">@Model.NetGGR.ToStringMoneyWithSymbol("$")</span>
        </div>
    </div>
</div>

@if (!Model.IsMaxSubLevel)
{
    <div class="dashboard-section-col">
        <span class="my-account">@Lang.SubAffiliate</span>
        <div class="group group-four">
            <div class="img-icon">
                <img class="img-responsive" src="~/www/build/styles/Images/account-overview/icon-subaff.png" alt="sub-aff icon" />
            </div>
            <div class="info-panel">
                <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.SubAffDownline</span>
                <span class="info-panel-content">@Model.NoOfSubAff</span>
            </div>

            <div class="info-panel">
                <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.SubAffEarning </span>
                <span class="info-panel-content">@Model.SubAffCommission.ToStringMoneyWithSymbol("$")</span>
            </div>
        </div>
    </div>
}