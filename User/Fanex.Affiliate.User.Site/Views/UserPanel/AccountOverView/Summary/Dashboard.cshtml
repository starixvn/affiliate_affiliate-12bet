@using Fanex.Affiliate.User.Core.CoreService
@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.AccountOverview.DashboardViewModel

@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();

    var isCurrentMonth = Model.IsCurrentMonth;
    var isGetMonthly = Model.IsGetMonthly;
    var isHybridAff = Model.IsHybridAff;
    var isCpaAff = Model.IsCpaAff;
    var isRevenueShareAff = Model.IsRevenueShareAff;
    var overviewSummary = Model.OverviewSummary;
}

<div class="dashboard-section-col">
    <span class="my-account">@Lang.MyAccount</span>
    <div class="group group-one">
        <div class="img-icon">
            <img class="img-responsive" src="~/www/build/styles/Images/account-overview/new-sign-up.svg" alt="New Signup icon" />
        </div>
        <div class="info-panel">
            <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.NewSignupAndDeposited</span>
            <span class="info-panel-content">@($"{overviewSummary.Signups}/{overviewSummary.DepositedMembers}")</span>
        </div>
        @if (isRevenueShareAff)
        {
            <div class="info-panel">
                <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.ActivePlayersAndQualified</span>
                <span class="info-panel-content">@($"{overviewSummary.ActivePlayers}/{overviewSummary.QualifiedMember}")</span>
            </div>
        }
        else
        {
            if (isCpaAff)
            {
                <div class="info-panel">
                    <span class="info-panel-title @sessionService.CurrentLanguage">
                        @Lang.QualifiedPlayers
                        <span title="@Lang.PlayersWhoPassed" class="margin-left-3 glyphicon glyphicon-info-sign"></span>
                    </span>
                    <span class="info-panel-content">@($"{overviewSummary.QualifiedMemberCPA}")</span>
                </div>
            }
            else
            {
                <div class="info-panel">
                    <span class="info-panel-title @sessionService.CurrentLanguage">
                        @Lang.ActivePlayers
                    </span>
                    <span class="info-panel-content">@($"{overviewSummary.ActivePlayers}")</span>
                </div>
            }
        }
    </div>
    @if (isHybridAff)
    {
        <div class="group group-one">
            <div class="img-icon">
                <img class="img-responsive" src="~/www/build/styles/Images/account-overview/new-sign-up.svg" alt="New Signup icon" />
            </div>
            <div class="info-panel">
                <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.QualifiedRevenueSharePlayers</span>
                <span class="info-panel-content">@($"{overviewSummary.QualifiedMember}")</span>
            </div>
            <div class="info-panel">
                <span class="info-panel-title @sessionService.CurrentLanguage">
                    @Lang.QualifiedCPAPlayers
                    <span title="@Lang.PlayersWhoPassed" class="margin-left-3 glyphicon glyphicon-info-sign"></span>
                </span>
                <span class="info-panel-content">@($"{overviewSummary.QualifiedMemberCPA}")</span>
            </div>
        </div>
    }

    @if (!isRevenueShareAff)
    {
        <div class="group group-two">
            <div class="img-icon">
                <img class="img-responsive" src="~/www/build/styles/Images/account-overview/commission.svg" alt="Commission icon" />
            </div>
            @if (isCurrentMonth)
            {
                <div class="info-panel">
                    <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.ApprovedCPAAmount</span>
                    <span class="info-panel-content">@overviewSummary.ApprovedCPAAmount.ToStringMoneyWithSymbol("$")</span>
                </div>
                <div class="info-panel">
                    <span class="info-panel-title @sessionService.CurrentLanguage">
                        @Lang.TentativeCPAAmount
                        <span title="@Lang.TotalCPAAmountForEligiblePlayers" class="margin-left-3 glyphicon glyphicon-info-sign"></span>
                    </span>
                    <span class="info-panel-content">@overviewSummary.TentativeCPAAmount.ToStringMoneyWithSymbol("$")</span>
                </div>
            }
            else
            {
                <div class="info-panel w-100">
                    <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.ApprovedCPAAmount</span>
                    <span class="info-panel-content">@overviewSummary.ApprovedCPAAmount.ToStringMoneyWithSymbol("$")</span>
                </div>
            }
        </div>
    }

    @if (isGetMonthly && !isCpaAff)
    {
        <div class="group group-two">
            <div class="img-icon">
                <img class="img-responsive" src="~/www/build/styles/Images/account-overview/commission.svg" alt="Commission icon" />
            </div>
            @if (isCurrentMonth)
            {
                <div class="info-panel">
                    <span class="info-panel-title @sessionService.CurrentLanguage">
                        @Lang.TentativeRevenueShare
                        <span title="@Lang.MonthToDateTentativeAmount" class="margin-left-3 glyphicon glyphicon-info-sign"></span>
                    </span>
                    <span class="info-panel-content">@overviewSummary.Commission.ToStringMoneyWithSymbol("$")</span>
                </div>
            }
            else
            {
                <div class="info-panel">
                    <span class="info-panel-title @sessionService.CurrentLanguage">
                        @Lang.RevenueShare
                    </span>
                    <span class="info-panel-content">@overviewSummary.Commission.ToStringMoneyWithSymbol("$")</span>
                </div>
            }
            <div class="info-panel">
                <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.BalForward</span>
                <span class="info-panel-content">@overviewSummary.BalanceBroughtForward.ToStringMoneyWithSymbol("$")</span>
            </div>
        </div>
    }
    else
    {
        <div class="group group-two">
            <div class="img-icon">
                <img class="img-responsive" src="~/www/build/styles/Images/account-overview/commission.svg" alt="Commission icon" />
            </div>
            <div class="info-panel w-100">
                <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.BalForward</span>
                <span class="info-panel-content">@overviewSummary.BalanceBroughtForward.ToStringMoneyWithSymbol("$")</span>
            </div>
        </div>
    }

    @if (!isGetMonthly || isCpaAff)
    {
        <div class="group group-three">
            <div class="img-icon">
                <img class="img-responsive" src="~/www/build/styles/Images/account-overview/total-deposit.svg" alt="Total Deposit icon" />
            </div>
            <div class="info-panel w-100">
                <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.TotalDeposit/@Lang.FdmDeposit</span>
                <span class="info-panel-content">@overviewSummary.Deposit.ToStringMoneyWithSymbol("$")/@overviewSummary.FdmDeposit.ToStringMoneyWithSymbol("$")</span>
            </div>
        </div>
    }
    else
    {
        <div class="group group-three">
            <div class="img-icon">
                <img class="img-responsive" src="~/www/build/styles/Images/account-overview/total-deposit.svg" alt="Total Deposit icon" />
            </div>
            <div class="info-panel">
                <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.TotalDeposit/@Lang.FdmDeposit</span>
                <span class="info-panel-content">@overviewSummary.Deposit.ToStringMoneyWithSymbol("$")/@overviewSummary.FdmDeposit.ToStringMoneyWithSymbol("$")</span>
            </div>
            <div class="info-panel">
                <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.NetRevenue</span>
                <span class="info-panel-content">@overviewSummary.NetGGR.ToStringMoneyWithSymbol("$")</span>
            </div>
        </div>
    }

    <div class="group group-five">
        <div class="img-icon">
            <img class="img-responsive" src="~/www/build/styles/Images/account-overview/icon-click.svg" alt="Click icon" />
        </div>
        <div class="info-panel">
            <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.TotalClick</span>
            <span class="info-panel-content">@overviewSummary.TotalClick.FormatNumber()</span>
        </div>
        <div class="info-panel">
            <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.UniqueClick</span>
            <span class="info-panel-content">@overviewSummary.UniqueClick.FormatNumber()</span>
        </div>
    </div>
</div>

@if (!Model.IsMaxSubLevel && Model.IsSubCommRate)
{
    <div class="dashboard-section-col">
        <span class="my-account">@Lang.SubAffiliate</span>
        <div class="group group-four">
            <div class="img-icon">
                <img class="img-responsive" src="~/www/build/styles/Images/account-overview/icon-subaff.png" alt="sub-aff icon" />
            </div>
            @if (isGetMonthly)
            {
                <div class="info-panel">
                    <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.SubAffDownline</span>
                    <span class="info-panel-content">@overviewSummary.NoOfSubAff</span>
                </div>

                <div class="info-panel">
                    <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.SubAffEarning </span>
                    <span class="info-panel-content">@overviewSummary.SubAffCommission.ToStringMoneyWithSymbol("$")</span>
                </div>
            }
            else
            {
                <div class="info-panel w-100">
                    <span class="info-panel-title @sessionService.CurrentLanguage">@Lang.SubAffDownline</span>
                    <span class="info-panel-content">@overviewSummary.NoOfSubAff</span>
                </div>
            }
        </div>
    </div>
}