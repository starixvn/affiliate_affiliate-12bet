@using Fanex.Affiliate.User.Core.CoreService

@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.AccountOverview.SummaryViewModel

@{
    var sessionService = DependencyResolver.Current.GetService<ISessionService>();
}

<div class="summary" id="summary">
    <div class="form-inline form-filter">
        <div class="form-group view-by-group">
            <label for="ViewBy">@Lang.ViewBy:</label>
            <div class="view-by-select-group">
                <select id="ViewBy" class="form-control">
                    <option value="0">@Lang.Month</option>
                    <option value="1">@Lang.DateRange</option>
                </select>
                @if (!Model.IsCpaAff)
                {
                    <div class="info-container">
                        <span title="@Lang.RevenueShareAndNetRevenue" class="glyphicon glyphicon-info-sign"></span>
                    </div>
                }
            </div>
        </div>

        <div class="form-group month-picker-group">
            <div id="monthPicker" class="form-wrapper d-inline-block">
                <input readonly id="MonthDate" data-original-date="@Model.FromDate.ToString("MM/dd/yyyy")" class="form-control month-date" type="text" value="@Model.ToDate.ToString("MMM-yyyy")" />
                <span class="glyphicon glyphicon-calendar" id="monthPickerTrigger"></span>
            </div>
        </div>

        <div class="form-group date-picker-group" style="display: none">
            <div class="form-group">
                <label for="FromDate">@Lang.From:</label>
                <div id="fromPicker" class="date-wrapper">
                    <input readonly class="form-control d-inline-block" type="text" id="FromDate" value="@Model.FromDate.ToString("MM/dd/yyyy")" />
                    <span class="glyphicon glyphicon-calendar"></span>
                </div>
            </div>
            <div class="form-group">
                <label for="ToDate">@Lang.To:</label>
                <div id="toPicker" class="date-wrapper">
                    <input readonly class="form-control d-inline-block" type="text" id="ToDate" value="@Model.ToDate.ToString("MM/dd/yyyy")" />
                    <span class="glyphicon glyphicon-calendar"></span>
                </div>
            </div>
        </div>

        <button class="btn btn-submit" id="dashboardSubmit" type="button" style="margin-bottom: 5px;">@Lang.Submit</button>
    </div>
    <div class="summary-content">
        <div class="dashboard-section @sessionService.CurrentLanguage" id="dashboard-section"></div>

        <div class="details-section" id="details-section">
            <div class="tab-menu details-section-menu" id="details-section-menu">
                <ul class="menu list-unstyled">
                    <li><a href="javascript:;" data-name="Overview" class="menu-item details-section-menu-item" id="menuOverview">@Lang.Overview</a></li>
                    <li><a href="javascript:;" data-name="PlayersDetails" class="menu-item details-section-menu-item" id="menuPlayersDetails">@Lang.PlayersDetails</a></li>
                    @if (!Model.IsMaxLevel)
                    {
                        <li><a href="javascript:;" data-name="SubAffDetails" class="menu-item details-section-menu-item" id="menuSubAffDetails">@Lang.SubAffDetail</a></li>
                    }
                </ul>
            </div>
            <div class="details-section-content" id="details-section-content"></div>
        </div>
    </div>
</div>

<script src="@Url.RenderLink("~/www/build/js/summary.js")"></script>