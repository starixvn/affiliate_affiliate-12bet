@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.AccountOverview.OverviewDetailViewModel

@{
    var overviewDetailList = Model.OverviewDetailList;
    var rowNum = overviewDetailList.Count();
    var itemTotal = overviewDetailList.LastOrDefault();
    var hasData = rowNum > 1;
    var hasScroll = rowNum > 11;
}

<div class="table">
    <table class="has-total" id="overview-table">
        <thead>
            <tr class="overview-table-header" id="overview-table-header">
                <th width="10%">@Lang.Date</th>
                <th width="10%">@Lang.NewSignUp</th>
                <th width="10%">@Lang.DepositedMembers</th>
                @if (!Model.IsCPAAff)
                {
                    <th width="10%">@Lang.ActivePlayers</th>
                }
                @if (Model.IsHybridAff)
                {
                    <th width="10%">@Lang.QualifiedRevenueSharePlayers</th>
                    <th width="10%">@Lang.QualifiedCPAPlayers</th>
                }
                else
                {
                    <th width="10%">@Lang.QualifiedPlayers</th>
                }
                <th width="10%">@Lang.Deposit <br /> (@Lang.CurrencyLabel)</th>
                <th width="10%">@Lang.Turnover <br /> (@Lang.CurrencyLabel)</th>
                <th width="10%">@Lang.Withdrawal <br /> (@Lang.CurrencyLabel)</th>
                <th width="10%">@Lang.GGR <br /> (@Lang.CurrencyLabel)</th>
            </tr>
            @{
                if (hasData)
                {
                    <tr class="overview-table-total" id="overview-table-total">
                        <th class="text-center">@Lang.Total</th>
                        <th class="text-center">@itemTotal.Signups</th>
                        <th class="text-center">@itemTotal.DepositedMembers</th>
                        @if (!Model.IsCPAAff)
                        {
                            <th class="text-center">@itemTotal.ActiveMembers</th>
                        }
                        @if (Model.IsHybridAff)
                        {
                            <th class="text-center">@itemTotal.QualifiedActiveMembers</th>
                            <th class="text-center">@itemTotal.QualifiedMemberCPA</th>
                        }
                        else
                        {
                            <th class="text-center">@itemTotal.QualifiedActiveMembers</th>
                        }
                        <th class="text-center">@itemTotal.Deposit.FormatDecimal()</th>
                        <th class="text-center">@itemTotal.Turnover.FormatDecimal()</th>
                        <th class="text-center">@itemTotal.Withdrawal.FormatDecimal()</th>
                        <th class="text-center">@itemTotal.GGR.FormatDecimal()</th>
                    </tr>
                }
            }
        </thead>
        <tbody class="@(hasScroll ? "has-scroll" : string.Empty)">
            @{
                if (hasData)
                {
                    for (var i = 0; i < rowNum - 1; i++)
                    {
                        var item = overviewDetailList.ElementAt(i);
                        <tr>
                            <td class="text-center">@item.WinlostDate.ToString("MM/dd/yyyy")</td>
                            <td class="text-center">@item.Signups</td>
                            <td class="text-center">@item.DepositedMembers</td>
                            @if (!Model.IsCPAAff)
                            {
                                <td class="text-center">@item.ActiveMembers</td>
                            }
                            @if (Model.IsHybridAff)
                            {
                                <td class="text-center">@item.QualifiedActiveMembers</td>
                                <td class="text-center">@item.QualifiedMemberCPA</td>
                            }
                            else
                            {
                                <td class="text-center">@item.QualifiedActiveMembers</td>
                            }
                            <td class="text-center">@item.Deposit.FormatDecimal()</td>
                            <td class="text-center">@item.Turnover.FormatDecimal()</td>
                            <td class="text-center">@item.Withdrawal.FormatDecimal()</td>
                            <td class="text-center">@item.GGR.FormatDecimal()</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center" colspan="@(Model.IsCPAAff ? 7 : (Model.IsRevenueShareAff ? 8 : 9))">@Lang.NoInfo</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script src="@Url.RenderLink("~/www/build/js/overview.js")"></script>