@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.AccountOverview.PlayerDetailViewModel

<div class="table player-detail-table">
    <table id="player-detail-table">
        <thead>
            <tr class="player-detail-table-header">
                <th width="5%">@Lang.STT</th>
                <th width="9%" class="th" data-name="Username">
                    <div class="th-wrapper">
                        <span>Username</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="RegisteredDate">
                    <div class="th-wrapper">
                        <span>@Lang.RegisteredDate</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="FdmDate">
                    <div class="th-wrapper">
                        <span>@Lang.FdmDate</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="FdmAmt">
                    <div class="th-wrapper">
                        <span>@Lang.FdmAmt <br /> (@Lang.CurrencyLabel)</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="Turnover">
                    <div class="th-wrapper">
                        <span>@Lang.Turnover <br /> (@Lang.CurrencyLabel)</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span id="defaultSorting" class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="GGR">
                    <div class="th-wrapper">
                        <span>@Lang.GGR <br /> (@Lang.CurrencyLabel)</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="Deposit">
                    <div class="th-wrapper">
                        <span>@Lang.Deposit <br /> (@Lang.CurrencyLabel)</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="Withdrawal">
                    <div class="th-wrapper">
                        <span>@Lang.Withdrawal <br /> (@Lang.CurrencyLabel)</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="Bonus">
                    <div class="th-wrapper">
                        <span>@Lang.Bonus <br /> (@Lang.CurrencyLabel)</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                <th width="9%" class="th" data-name="Rebate">
                    <div class="th-wrapper">
                        <span>@Lang.Rebate <br /> (@Lang.CurrencyLabel)</span>
                        <div class="icon-container">
                            <span class="caret asc"></span>
                            <span class="caret desc"></span>
                        </div>
                    </div>
                </th>
                @if (Model.IsDepositFeePercent && !Model.IsCpaAff)
                {
                    <th width="9%" class="th" data-name="DepositFee">
                        <div class="th-wrapper">
                            <span>@Lang.DepositFee <br /> (@Lang.CurrencyLabel)</span>
                            <div class="icon-container">
                                <span class="caret asc"></span>
                                <span class="caret desc"></span>
                            </div>
                        </div>
                    </th>
                }

                @if (Model.IsWithdrawalFeePercent && !Model.IsCpaAff)
                {
                    <th width="9%" class="th" data-name="WithdrawalFee">
                        <div class="th-wrapper">
                            <span>@Lang.WithdrawalFee <br /> (@Lang.CurrencyLabel)</span>
                            <div class="icon-container">
                                <span class="caret asc"></span>
                                <span class="caret desc"></span>
                            </div>
                        </div>
                    </th>
                }
            </tr>
        </thead>
        <tbody id="player-detail-content">
            @{ Html.RenderPartial("~/Views/UserPanel/AccountOverView/Summary/PlayersDetailsContent.cshtml", Model); }
        </tbody>
    </table>
</div>
<div class="player-detail-pager" id="player-detail-pager"></div>

<script src="@Url.RenderLink("~/www/build/js/player-detail.js")"></script>