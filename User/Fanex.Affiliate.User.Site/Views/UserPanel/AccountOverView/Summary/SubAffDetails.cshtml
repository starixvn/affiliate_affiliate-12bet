@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.AccountOverview.SubAffDetailViewModel
@{
    var subAffDetailList = Model.SubAffDetailList;
}

<div class="table">
    <table id="sub-aff-detail-table">
        <thead>
            <tr>
                <th width="5%">No.</th>
                <th width="7%">@Lang.Username</th>
                <th width="7%">@Lang.FName</th>
                <th width="7%">@Lang.LName</th>
                <th width="9%">@Lang.ApprovalDate</th>
                <th width="8%" hidden>@Lang.SuspensionSatus</th>
                <th width="8%" hidden>@Lang.SuspensionDate</th>
                <th width="9%">@Lang.TotalTurnover <br /> (@Lang.CurrencyLabel)</th>
                <th width="9%">@Lang.TotalGGR <br /> (@Lang.CurrencyLabel)</th>
                @if (Model.IsGetMonthly)
                {
                    <th width="9%">@Lang.TotalCommission <br /> (@Lang.CurrencyLabel)</th>
                }
                <th width="7%">@Lang.ActivePlayers</th>
                <th width="7%">@Lang.QualifiedRevenueSharePlayers</th>
                <th width="7%">@Lang.QualifiedCPAPlayers</th>
                <th width="7%" hidden>@Lang.Remove</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (subAffDetailList != null && subAffDetailList.Any())
                {
                    var startRowNumber = 1;
                    foreach (var item in subAffDetailList)
                    {
                        <tr>
                            <td class="text-center">@startRowNumber</td>
                            <td class="text-center break-all">@item.UserName</td>
                            <td class="text-center">@Html.Raw(item.FirstName)</td>
                            <td class="text-center">@Html.Raw(item.LastName)</td>
                            <td class="text-center">@item.ApprovedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="text-center">@item.Turnover.FormatDecimal()</td>
                            <td class="text-center">@item.GGR.FormatDecimal()</td>
                            @if (Model.IsGetMonthly)
                            {
                                <td class="text-center">@(item.IsCPAAff ? "-" : item.Commission.FormatDecimal())</td>
                            }

                            <td class="text-center">@(item.IsCPAAff ? "-" : item.ActivePlayer.ToString())</td>
                            <td class="text-center">@(item.IsCPAAff ? "-" : item.QualifiedMember.ToString())</td>
                            <td class="text-center">@(item.IsRevenueShareAff ? "-" : item.QualifiedMemberCPA.ToString())</td>
                        </tr>

                        startRowNumber++;
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center" colspan="@(Model.IsGetMonthly ? 11 : 10)">@Lang.NoInfo</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>