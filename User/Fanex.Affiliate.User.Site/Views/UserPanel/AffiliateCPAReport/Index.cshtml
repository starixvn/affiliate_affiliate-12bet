@{
    Layout = null;
    var currentYear = DateTimeHelper.Gmt8CurrentYear;
    var fromDate = ViewBag.FromDate;
    var toDate = ViewBag.ToDate;
}


@Html.InlineStyles("~/www/build/styles/css/affiliate-cpa-report.css")

<div class="page-title">
    <span class="text">@Lang.CommissionReport</span>
</div>

<div class="info-group">
    <div class="panel custom-panel">
        <div class="panel-body">
            <form class="form-inline form-filter">
                <div class="form-group">
                    <label>CPA Status:</label>
                    <select id="Status" class="form-control">
                        <option value="-1">@Lang.All</option>
                        <option value="2">@Lang.Eligible</option>
                        <option value="3">@Lang.Approved</option>
                        <option value="1">@Lang.Ineligible</option>
                        <option value="4">@Lang.Rejected</option>
                        <option value="5">@Lang.QuotaExceeded</option>
                        <option value="0">@Lang.Pending</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>View By:</label>
                    <select id="ViewBy" class="form-control view-by-select">
                        <option value="1">@Lang.ActiveQualifiedDate</option>
                        <option value="2">@Lang.HoldingQualifiedDate</option>
                        <option value="3">@Lang.ApprovalDate</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>@Lang.From:</label>
                    <div id="fromPicker" class="date-wrapper">
                        <input readonly class="form-control" type="text" id="FromDate" value="@ViewBag.FromDate" />
                        <span class="glyphicon glyphicon-calendar"></span>
                    </div>
                </div>
                <div class="form-group">
                    <label>@Lang.To:</label>
                    <div id="toPicker" class="date-wrapper">
                        <input readonly class="form-control" type="text" id="ToDate" value="@ViewBag.ToDate" />
                        <span class="glyphicon glyphicon-calendar"></span>
                    </div>
                </div>
                <div class="form-group">
                    <button type="button" class="btn btn-submit" id="btnSubmit">@Lang.Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="report-container">
    <div id="monthly-cpa-report" class="table monthly-cpa-report table-responsive display-none">
        <table id="monthlyDataTable" class="table table-medium monthlyDataTable">
            <thead>
                <tr>
                    <th width="3%" class="th">#</th>
                    <th width="20%" class="th" data-name="Month">
                        <div class="th-wrapper">
                            <span>@Lang.Month</span>
                            <div class="icon-container">
                                <span class="caret asc"></span>
                                <span id="defaultSorting" class="caret desc"></span>
                            </div>
                        </div>
                    </th>
                    <th width="10%" class="th" data-name="Quota">
                        <div class="th-wrapper">
                            <span>@Lang.Quota</span>
                            <div class="icon-container">
                                <span class="caret asc"></span>
                                <span class="caret desc"></span>
                            </div>
                        </div>
                    </th>
                    <th width="20%" class="th" data-name="CPAAmount">
                        <div class="th-wrapper">
                            <span>@Lang.CPAAmount</span>
                            <div class="icon-container">
                                <span class="caret asc"></span>
                                <span class="caret desc"></span>
                            </div>
                        </div>
                    </th>
                    <th width="20%" class="th" data-name="EstimatedCPAAmount">
                        <div class="th-wrapper">
                            <span>@Lang.EstimatedCPAAmount</span>
                            <div class="icon-container">
                                <span class="caret asc"></span>
                                <span class="caret desc"></span>
                            </div>
                        </div>
                    </th>
                    <th width="20%" class="th" data-name="ApprovedCPAAmount">
                        <div class="th-wrapper">
                            <span>@Lang.ApprovedCPAAmount</span>
                            <div class="icon-container">
                                <span class="caret asc"></span>
                                <span class="caret desc"></span>
                            </div>
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody id="monthlyReportData"></tbody>
        </table>

    </div>
    <div id="player-cpa-report" class="table player-cpa-report table-responsive display-none">
        <table id="playerDataTable">
            <thead>
                <!-- Main category header row -->
                <tr>
                    <th rowspan="2" width="3%" class="th">#</th>
                    <th rowspan="2" width="10%" class="th">@Lang.Player</th>
                    <th rowspan="2" width="8%" class="th">@Lang.RegistrationDate</th>
                    <th colspan="4" class="th ">@Lang.ActivePeriod</th>
                    <th colspan="3" class="th">@Lang.HoldingPeriod</th>
                    <th colspan="4" class="th">@Lang.ApprovalPeriod</th>
                </tr>
                <!-- Column header row -->
                <tr>
                    <th class="th">@Lang.FTD</th>
                    <th class="th">@Lang.TotalDeposit</th>
                    <th class="th">@Lang.ActiveQualifiedDate</th>
                    <th class="th">@Lang.CPAAmount</th>
                    <th class="th">@Lang.BetTicket</th>
                    <th class="th">@Lang.HoldingQualifiedDate</th>
                    <th class="th">@Lang.HoldingExpiredDate</th>
                    <th class="th">@Lang.EstimatedCPAAmount</th>
                    <th class="th">@Lang.ApprovedCPAAmount</th>
                    <th class="th">@Lang.CPAStatus</th>
                    <th class="th">@Lang.Approval_Date</th>
                </tr>
            </thead>
            <tbody id="playerReportData"></tbody>
        </table>
    </div>
    <div id="playerCPAPager"></div>
    <div id="play-cpa-turnover" class="table player-cpa-turn-over-report table-responsive modal-dialog modal fade display-none" tabindex="-1">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Turnover CPA Detail
                </h5>
                <button type="button" class="close-btn" id="closeModal">×</button>
            </div>
            <div class="modal-body">
                <table id="playerTurnoverDataTable" class="table table-medium playerTurnoverDataTable">
                    <thead>
                        <tr>
                            <th width="20%" class="th">@Lang.ProductGroup</th>
                            <th width="20%" class="th"> @Lang.Turnover</th>
                            <th width="20%" class="th">@Lang.CPAAmount</th>
                        </tr>
                    </thead>
                    <tbody id="playerTurnoverReportData"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    var langResource = {
        noInfo: '@Lang.NoInfo',
        total: '@Lang.Total',
        theHighestShare: '@Lang.TheHighestShare',
        isMaxLevel: '@Model'.toLowerCase() === 'true',
        isInvalid: '@Error.IsInvalid'
    }
</script>
<input type="hidden" id="TotalItem" value="" />
<script src="@Url.RenderLink("~/www/build/js/pages/affiliate-cpa-report.js")"></script>