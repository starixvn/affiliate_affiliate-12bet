@{
    Layout = null;
}

@Html.InlineStyles("~/www/build/styles/css/pages/cpa-report/redeposit-cpa-report.css")
@model Fanex.Affiliate.User.Core.ViewModels.UserPanel.CPAReport.RedepositCPAReportViewModel
<div class="report-container">
    <div class="page-title">
        <span class="text">@Lang.RedepositCPAReport</span>
    </div>
    <div class="info-group redeposit-cpa-report">
        <div class="panel custom-panel">
            <div class="panel-body">
                <form class="form-inline form-filter">
                    <div class="form-group">
                        <label>@Lang.From:</label>
                        <div id="fromPicker" class="date-wrapper">
                            <input readonly id="FromDate" class="form-control" type="text" value="@Model.FromDate.ToString("MM/dd/yyyy")" />
                            <span class="glyphicon glyphicon-calendar"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>@Lang.To:</label>
                        <div id="toPicker" class="date-wrapper">
                            <input readonly id="ToDate" class="form-control" type="text" value="@Model.ToDate.ToString("MM/dd/yyyy")" />
                            <span class="glyphicon glyphicon-calendar"></span>
                        </div>
                    </div>
                    <button type="button" class="btn btn-submit btn-redeposit-cpa-report" id="btnSubmit">@Lang.Submit</button>
                </form>
            </div>
        </div>

        <div class="table">
            <table id="data-table">
                <thead>
                <tr>
                    <th width="3%" class="th" rowspan="2">#</th>
                    <th class="th" colspan="4">@Lang.CPAPaymentDetails</th>
                    <th class="th" colspan="3">@Lang.RedepositStatistics</th>
                    <th class="th" rowspan="2" data-name="TotalSettledCPAAmount"> @Lang.TotalSettledCPAAmount</th>
                    <th class="th" rowspan="2" data-name="Status"> @Lang.Status</th>
                </tr>
                <tr>
                    <th class="th" data-name="StartFrom">@Lang.StartFrom</th>
                    <th class="th" data-name="ApprovalDate"> @Lang.ApprovalDate</th>
                    <th class="th" data-name="RecheckDay"> @Lang.RecheckDay</th>
                    <th class="th" data-name="ExpiredRedepositDate"> @Lang.ExpiredRedepositDate</th>
                    <th class="th" data-name="ApprovedCPAPlayer"> @Lang.ApprovedCPAPlayer</th>
                    <th class="th" data-name="RedepositRate"> @Lang.RedepositRate</th>
                    <th class="th" data-name="NumberOfPlayerRedeposit"> @Lang.NumberOfPlayerRedeposit</th>
                </tr>
                </thead>
                <tbody id="report-data"></tbody>
            </table>
            <div id="redeposit-CPA-report-pager"></div>
        </div>
    </div>
</div>

<script>
    var langResource = {
        noInfo: '@Lang.NoInfo',
        totalAllPages: '@Lang.TotalAllPages',
        days: '@Lang.Days'
    }
</script>

<script src="@Url.RenderLink("~/www/build/js/pages/cpa-report/redeposit-cpa-report.js")"></script>