@model IEnumerable<Fanex.Affiliate.User.Core.ViewModels.UserPanel.StatementHistoryViewModel>

@helper RenderItem(Fanex.Affiliate.User.Core.ViewModels.UserPanel.StatementHistoryViewModel item, int id, int? parentId = null, int? index = null)
{
    var isLink = (item.TransType == (byte)Fanex.Affiliate.User.Core.Enum.TransType.SubAffiliate
                 || item.TransType == (byte)Fanex.Affiliate.User.Core.Enum.TransType.ApprovedCpaEarning
                 || item.TransType == (byte)Fanex.Affiliate.User.Core.Enum.TransType.CpaAdjustment
                 || item.TransType == (byte)Fanex.Affiliate.User.Core.Enum.TransType.MonthlyEarning)
                 && DateTime.Compare(item.MonthDate, ViewBag.AvailableFromDate) > 0;

    var hasChildren = item.Children == null || item.Children.Any();
    var displayClass = parentId != null ? "display-none" : "";

    <tr data-id='@id' data-parent='@parentId' class='@displayClass'>
        <td>@index</td>
        <td class="text-bold">
            <div class="flex">
                <span class="flex-0">@item.DateString</span>
                @if (hasChildren)
                {
                    <div class="flex-middle">
                        <button class="btn btn-transparent">
                            <span class="chevron right"></span>
                        </button>
                    </div>
                }
            </div>
        </td>
        <td>@item.TransTypeString</td>
        <td class="text-right">
            @if (isLink)
            {
                <a class="amountItem" data-date="@item.MonthDate.ToString("yyyy-MM-dd")" data-transtype="@item.TransType" data-description="@item.Description" href="javascript:;">
                    @item.Amount.ToStringMoneyWithSymbol()
                </a>
            }
            else
            {
                @item.Amount.ToStringMoneyWithSymbol()
            }
        </td>
        <td class="text-center">@item.DisplayStatus</td>
        <td>
            @Html.Raw(item.DescriptionDisplay)
        </td>
    </tr>
}


<div class="table table-responsive">
    <table>
        <thead>
            <tr>
                <th width="5%"></th>
                <th width="20%">@Lang.Date</th>
                <th width="20">@Lang.Type</th>
                <th width="12%">@Lang.Amount</th>
                <th width="12%">@Lang.Status</th>
                <th width="31%">@Lang.Description</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null && Model.Any())
                {
                    var index = (int)ViewBag.StartRowNumber;
                    var id = 1;

                    foreach (var item in Model)
                    {
                        @RenderItem(item, id, index: index);
                        if (item.Children != null)
                        {
                            var parentId = id;
                            foreach (var child in item.Children)
                            {
                                id++;
                                @RenderItem(child, id, parentId: parentId)
                            }
                        }

                        index++;
                        id++;
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center" colspan="6">@Lang.NoInfo</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<input type="hidden" id="TotalItem" value="@ViewBag.TotalItem" />