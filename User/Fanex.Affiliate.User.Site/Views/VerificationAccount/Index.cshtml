@{
    Layout = "~/Views/Shared/_LayoutBeforeLogin.cshtml";
}

@model Fanex.Affiliate.User.Core.ViewModels.VerificationAccountViewModel

@{
    var email = Model.Email;
    if (string.IsNullOrEmpty(email))
    {
        <div class="page-container">
            <h4 class="text-danger">@Lang.YouDoNotHaveEmail</h4>
        </div>
    }
    else
    {
        @section styles{
            @Html.InlineStyles("~/www/build/styles/css/verification-account.css")
        }

        @section scripts{
            <script type="text/javascript">
                var resource = {
                    verificationFailed: '@Error.VerificationFailed',
                    general: '@Error.General',
                    invalidEmail: '@Error.InvalidEmail',
                    wait60Seconds: '@Error.Wait60Seconds',
                    errAuthorized: '@Lang.ErrAuthorized',
                }
            </script>
            <script src="@Url.RenderLink("~/www/build/js/validation.js")"></script>
            @Html.InlineScripts("~/www/build/js/pages/verification-account.js")
        }
        <div class="block">
            <div class="page-container">
                <div class="verification-account">
                    <div class="noted-text">
                        <p>@Lang.DearCustomer</p>
                        <p>@Lang.DueTo</p>
                        <p>@Html.Raw(string.Format(Lang.YourRegisterEmail, email))</p>
                    </div>
                    <form class="form" id="sendCodeForm">
                        <div class="form-group form-columns form-columns-2" id="emailGroup">
                            <div class="items validate-group">
                                <label for="Email" class="custom-label">@Lang.EmailVerification <span class="red-warn">*</span></label>
                                <div class="captcha-group">
                                    <input type="text" class="form-input" autocomplete="off" data-val="true" data-val-required="@Lang.EmailIsRequired" id="Email" name="Email" />
                                    <button type="button" class="btn btn-sendcode custom-button" id="btnSendCode">@Lang.SendCode</button>
                                </div>
                                 <span class="validate-input field-validation-error hide" data-valmsg-for="Email" data-valmsg-replace="true" id="emailValidationMessage"></span>
                            </div>
                        </div>
                    </form>
                    <div class="hide" id="verificationAccountGroup">
                        <div class="noted-text">
                            <p>@Lang.AVerificationCode @Html.Raw(string.Format(Lang.ForAnyReason, Url.RenderLanguageContent("~/ContactUs")))</p>
                        </div>
                        
                        <form class="form" id="verificationAccountForm">
                            @Html.AntiForgeryToken()

                            <div class="form-group form-columns form-columns-2">
                                <div class="items validate-group">
                                    <label for="Usename" class="custom-label">@Lang.UsernameVerification <span class="red-warn">*</span></label>
                                    <input type="text" class="form-input" autocomplete="off" data-val="true" data-val-required="@Lang.UsernameIsRequired" id="Usename" name="Usename" />
                                    <span class="validate-input field-validation-error hide" data-valmsg-for="Usename" data-valmsg-replace="true"></span>
                                </div>

                                <div class="items validate-group">
                                    <label for="Password" class="custom-label">@Lang.PasswordVerification <span class="red-warn">*</span></label>
                                    <input type="password" class="form-input" data-val="true" data-val-required="@Lang.PasswordIsRequired" id="Password" name="Password" autocomplete="off" />
                                    <span class="validate-input field-validation-error hide" data-valmsg-for="Password" data-valmsg-replace="true"></span>
                                </div>
                            </div>
                            <div class="form-group form-columns form-columns-2">
                                <div class="items validate-group">
                                    <label for="Code" class="custom-label">@Lang.VerificationCode <span class="red-warn">*</span></label>
                                    <input type="text" class="form-input" autocomplete="off" data-val="true" data-val-required="@Lang.VerificationCodeIsRequired" id="Code" name="Code" />
                                    <span class="validate-input field-validation-error hide" data-valmsg-for="Code" data-valmsg-replace="true"></span>
                                </div>
                                <div class="items validate-group">
                                    <label for="Captcha" class="custom-label">@Lang.Captcha <span class="red-warn">*</span></label>
                                    <div class="captcha-group">
                                        <input type="text" class="form-input" data-val="true" data-val-required="@Lang.CaptchaIsRequired" id="Captcha" name="Captcha" />
                                        <div class="validation-value" id="verifyAccCaptchaBtn">
                                            <img id="verifyAccCaptchaImg" src="@Url.RenderLanguageContent("~/VerificationAccount/CaptchaImage?_v=" + DateTime.Now.ToLongTimeString())" alt="captcha" />
                                        </div>
                                    </div>
                                    <span class="validate-input field-validation-error hide" data-valmsg-for="Code" data-valmsg-replace="true"></span>
                                </div>
                            </div>

                            <div class="captcha-group">
                                <button type="button" class="btn btn-sendcode custom-button login-button" id="btnLoginVerification">@Lang.Login</button>
                            </div>

                            @Html.Hidden("VerificationToken")
                            @Html.Hidden("ActionLink")
                            @Html.Hidden("ActionToken")
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}